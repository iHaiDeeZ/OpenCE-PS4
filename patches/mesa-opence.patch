 src/util/disk_cache.c   | 5 +++++
 src/util/fossilize_db.c | 6 ++++++
 src/util/os_misc.c      | 4 +++-
 3 files changed, 14 insertions(+), 1 deletion(-)

diff --git a/src/util/disk_cache.c b/src/util/disk_cache.c
