From e449b0ce7a76513544a6eb5dc5cbe09e1ed541b7 Mon Sep 17 00:00:00 2001
From: ShiroKlein <ihaideezi@gmail.com>
Date: Thu, 22 Oct 2026 07:38:02 +0300
Subject: [PATCH 4/4] PS4: six cores for Gallium's threaded context and
 glthread (OpenOrbis's sysconf says one), glthread on in the PS4 frontend, two
 frames in flight

---
 src/gallium/frontends/ps4/ps4_gl.c | 20 ++++++++++++++------
 src/gallium/frontends/ps4/ps4_gl.h |  2 +-
 src/util/u_cpu_detect.c            |  7 +++++++
 3 files changed, 22 insertions(+), 7 deletions(-)

diff --git a/src/gallium/frontends/ps4/ps4_gl.c b/src/gallium/frontends/ps4/ps4_gl.c
index 8a13e23..513daef 100644
--- a/src/gallium/frontends/ps4/ps4_gl.c
+++ b/src/gallium/frontends/ps4/ps4_gl.c
@@ -29,6 +29,7 @@
 #include "util/u_atomic.h"
 #include "util/u_inlines.h"
 #include "util/u_memory.h"
+#include "util/u_debug.h"
 #include "zink/zink_kopper.h"
 #include "zink/zink_public.h"
 #include "glapi.h"
@@ -39,7 +40,8 @@ struct ps4gl_window {
    struct kopper_loader_info info;
    struct pipe_resource *textures[ST_ATTACHMENT_COUNT];
    unsigned width, height;
-   struct pipe_fence_handle *throttle_fence;
+   /* the last frames' fences: a frame waits for the one two frames back */
+   struct pipe_fence_handle *throttle_fences[2];
    bool flushing;
 };
 
@@ -241,6 +243,10 @@ ps4gl_create_context(struct ps4gl_window *window, bool es, int major, int minor,
       return NULL;
    }
    context->window = window;
+   /* glthread: the GL calls recorded on the caller's thread and run on
+    * another (as the DRI frontend does with mesa_glthread, on by default here) */
+   if (debug_get_bool_option("mesa_glthread", true))
+      _mesa_glthread_init(context->st->ctx);
    return context;
 }
 
@@ -283,12 +289,14 @@ ps4gl_swap_buffers(struct ps4gl_context *context)
    window->flushing = true;
    st_context_flush(context->st, ST_FLUSH_END_OF_FRAME, &fence, before_flush, context);
    window->flushing = false;
-   /* one frame in flight: wait for the previous one (dri_flush's throttle) */
-   if (window->throttle_fence) {
-      pscreen->fence_finish(pscreen, NULL, window->throttle_fence, OS_TIMEOUT_INFINITE);
-      pscreen->fence_reference(pscreen, &window->throttle_fence, NULL);
+   /* two frames in flight (dri_flush's throttle allows one): this one waits
+    * for the frame two back, so a slow frame does not stall the next */
+   if (window->throttle_fences[0]) {
+      pscreen->fence_finish(pscreen, NULL, window->throttle_fences[0], OS_TIMEOUT_INFINITE);
+      pscreen->fence_reference(pscreen, &window->throttle_fences[0], NULL);
    }
-   window->throttle_fence = fence;
+   window->throttle_fences[0] = window->throttle_fences[1];
+   window->throttle_fences[1] = fence;
    pscreen->flush_frontbuffer(pscreen, context->st->pipe, back, 0, 0, window, 0, NULL);
    /* the next frame validates the framebuffer again (the next image) */
    p_atomic_inc(&window->base.stamp);
