@@ -779,6 +779,13 @@ _util_cpu_detect_once(void)
 #  endif /* DETECT_OS_BSD */
 #endif /* DETECT_OS_POSIX */
 
+#ifdef __PS4__
+   /* PS4: OpenOrbis's sysconf answers 1 (it asks the kernel with Linux's call
+    * numbers), which turned Gallium's threaded context and glthread off. An
+    * app runs on six of the seven cores. */
+   available_cpus = 6;
