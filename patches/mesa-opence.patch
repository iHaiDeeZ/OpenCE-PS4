diff --git a/src/gallium/frontends/ps4/meson.build b/src/gallium/frontends/ps4/meson.build
new file mode 100644
index 0000000..ed9a376
--- /dev/null
+++ b/src/gallium/frontends/ps4/meson.build
@@ -0,0 +1,16 @@
+# Copyright 2026 OpenCE PS4 contributors
+# SPDX-License-Identifier: MIT
+
+# PS4: OpenGL (ES) contexts on Zink with a kopper swapchain on a headless
+# surface (ps4_gl.h). A static library the app links with Zink, the GL core
+# and RADV.
+libps4gl = static_library(
+  'ps4gl',
+  files('ps4_gl.c', 'ps4_gl.h'),
+  include_directories : [
+    inc_include, inc_util, inc_mesa, inc_src, inc_gallium,
+    inc_gallium_aux, inc_gallium_drivers, inc_glapi,
+  ],
+  dependencies : [idep_mesautil, dep_thread, idep_nir_headers],
+  build_by_default : true,
+)
diff --git a/src/gallium/frontends/ps4/ps4_gl.c b/src/gallium/frontends/ps4/ps4_gl.c
new file mode 100644
index 0000000..8a13e23
--- /dev/null
+++ b/src/gallium/frontends/ps4/ps4_gl.c
@@ -0,0 +1,314 @@
+/*
+ * Copyright 2026 OpenCE PS4 contributors
+ * SPDX-License-Identifier: MIT
+ */
+
+/*
+ * The PS4 frontend (ps4_gl.h): the parts of the DRI frontend's kopper path
+ * (frontends/dri/kopper.c, dri_drawable.c, dri_context.c) that a single
+ * window on a headless surface needs, without the DRI loader interface.
+ */
+
+#include "ps4_gl.h"
+
+#include <stdarg.h>
+#include <stdio.h>
+#include <string.h>
+
+#include <vulkan/vulkan_core.h>
+
+#include "frontend/api.h"
+#include "kopper_interface.h"
+#include "main/glthread.h"
+#include "main/mtypes.h"
+#include "pipe/p_context.h"
+#include "pipe/p_screen.h"
+#include "pipe/p_state.h"
+#include "state_tracker/st_context.h"
+#include "util/os_time.h"
+#include "util/u_atomic.h"
+#include "util/u_inlines.h"
+#include "util/u_memory.h"
+#include "zink/zink_kopper.h"
+#include "zink/zink_public.h"
+#include "glapi.h"
+
+struct ps4gl_window {
+   struct pipe_frontend_drawable base;
+   struct st_visual visual;
+   struct kopper_loader_info info;
+   struct pipe_resource *textures[ST_ATTACHMENT_COUNT];
+   unsigned width, height;
+   struct pipe_fence_handle *throttle_fence;
+   bool flushing;
+};
+
+struct ps4gl_context {
+   struct st_context *st;
+   struct ps4gl_window *window;
+};
+
+static struct pipe_frontend_screen screen;
+static struct st_config_options options;
+static char error_text[256];
+static uint32_t next_drawable_id;
+
+static void
+set_error(const char *format, ...)
+{
+   va_list arguments;
+
+   va_start(arguments, format);
+   vsnprintf(error_text, sizeof(error_text), format, arguments);
+   va_end(arguments);
+}
+
+const char *
+ps4gl_error(void)
+{
+   return error_text;
+}
+
+static int
+screen_get_param(struct pipe_frontend_screen *fscreen, enum st_manager_param param)
+{
+   (void)fscreen;
+   (void)param;
+   return 0;
+}
+
+bool
+ps4gl_initialize(void)
+{
+   struct pipe_screen *pscreen;
+
+   if (screen.screen)
+      return true;
+   pscreen = zink_create_screen(NULL, NULL);
+   if (!pscreen) {
+      set_error("Zink could not create its screen (no Vulkan device, or one Zink cannot use)");
+      return false;
+   }
+   screen.screen = pscreen;
+   screen.get_param = screen_get_param;
+   return true;
+}
+
+/* ---------- the window */
+
+static bool
+window_validate(struct st_context *st, struct pipe_frontend_drawable *drawable,
+                const enum st_attachment_type *statts, unsigned count,
+                struct pipe_resource **out, struct pipe_resource **resolve)
+{
+   struct ps4gl_window *window = (struct ps4gl_window *)drawable;
+   struct pipe_screen *pscreen = screen.screen;
+   unsigned index;
+
+   (void)st;
+   if (resolve)
+      *resolve = NULL;
+   for (index = 0; index < count; index++) {
+      enum st_attachment_type statt = statts[index];
+      struct pipe_resource templ;
+
+      if (!window->textures[statt]) {
+         memset(&templ, 0, sizeof(templ));
+         templ.target = PIPE_TEXTURE_2D;
+         templ.width0 = window->width;
+         templ.height0 = window->height;
+         templ.depth0 = 1;
+         templ.array_size = 1;
+         if (statt == ST_ATTACHMENT_DEPTH_STENCIL) {
+            templ.format = window->visual.depth_stencil_format;
+            templ.bind = PIPE_BIND_DEPTH_STENCIL;
+            if (templ.format != PIPE_FORMAT_NONE)
+               window->textures[statt] = pscreen->resource_create(pscreen, &templ);
+         } else if (statt == ST_ATTACHMENT_BACK_LEFT) {
+            /* the swapchain's images, behind one resource (kopper) */
+            templ.format = window->visual.color_format;
+            templ.bind = PIPE_BIND_RENDER_TARGET | PIPE_BIND_SAMPLER_VIEW | PIPE_BIND_DISPLAY_TARGET;
+            window->textures[statt] = pscreen->resource_create_drawable(pscreen, &templ, &window->info);
+         } else {
+            templ.format = window->visual.color_format;
+            templ.bind = PIPE_BIND_RENDER_TARGET | PIPE_BIND_SAMPLER_VIEW;
+            window->textures[statt] = pscreen->resource_create(pscreen, &templ);
+         }
+      }
+      out[index] = NULL;
+      pipe_resource_reference(&out[index], window->textures[statt]);
+   }
+   return true;
+}
+
+static bool
+window_flush_front(struct st_context *st, struct pipe_frontend_drawable *drawable,
+                   enum st_attachment_type statt)
+{
+   (void)st;
+   (void)drawable;
+   (void)statt;
+   /* only the back buffer is ever shown */
+   return true;
+}
+
+static bool
+window_flush_swapbuffers(struct st_context *st, struct pipe_frontend_drawable *drawable)
+{
+   (void)st;
+   (void)drawable;
+   return true;
+}
+
+struct ps4gl_window *
+ps4gl_create_window(unsigned width, unsigned height, int depth_bits, int stencil_bits)
+{
+   struct ps4gl_window *window = CALLOC_STRUCT(ps4gl_window);
+   VkHeadlessSurfaceCreateInfoEXT *headless;
+
+   if (!window) {
+      set_error("out of memory");
+      return NULL;
+   }
+   window->width = width;
+   window->height = height;
+   window->visual.buffer_mask = ST_ATTACHMENT_BACK_LEFT_MASK;
+   window->visual.color_format = PIPE_FORMAT_R8G8B8A8_UNORM;
+   window->visual.depth_stencil_format = PIPE_FORMAT_NONE;
+   if (depth_bits > 0 || stencil_bits > 0) {
+      window->visual.buffer_mask |= ST_ATTACHMENT_DEPTH_STENCIL_MASK;
+      window->visual.depth_stencil_format = stencil_bits > 0 ? PIPE_FORMAT_Z24_UNORM_S8_UINT :
+         depth_bits > 24 ? PIPE_FORMAT_Z32_FLOAT : PIPE_FORMAT_Z24X8_UNORM;
+      if (!screen.screen->is_format_supported(screen.screen, window->visual.depth_stencil_format,
+                                              PIPE_TEXTURE_2D, 0, 0, PIPE_BIND_DEPTH_STENCIL))
+         window->visual.depth_stencil_format = stencil_bits > 0 ? PIPE_FORMAT_Z32_FLOAT_S8X24_UINT :
+            PIPE_FORMAT_Z32_FLOAT;
+   }
+   window->visual.accum_format = PIPE_FORMAT_NONE;
+
+   /* the surface: VK_EXT_headless_surface; the drawable is the key Zink
+    * finds its swapchain by (zink_kopper.c) */
+   headless = (VkHeadlessSurfaceCreateInfoEXT *)&window->info.bos;
+   headless->sType = VK_STRUCTURE_TYPE_HEADLESS_SURFACE_CREATE_INFO_EXT;
+   headless->pNext = NULL;
+   headless->flags = 0;
+   window->info.bos.padding[2] = (intptr_t)window;
+   window->info.has_alpha = 0;
+   window->info.initial_swap_interval = 1;
+   window->info.present_opaque = true;
+
+   window->base.visual = &window->visual;
+   window->base.fscreen = &screen;
+   window->base.ID = p_atomic_inc_return(&next_drawable_id);
+   window->base.stamp = 1;
+   window->base.validate = window_validate;
+   window->base.flush_front = window_flush_front;
+   window->base.flush_swapbuffers = window_flush_swapbuffers;
+   return window;
+}
+
+/* ---------- contexts */
+
+struct ps4gl_context *
+ps4gl_create_context(struct ps4gl_window *window, bool es, int major, int minor, bool debug)
+{
+   struct ps4gl_context *context;
+   struct st_context_attribs attribs;
+   enum st_context_error error = ST_CONTEXT_SUCCESS;
+
+   if (!screen.screen || !window) {
+      set_error("no screen or window");
+      return NULL;
+   }
+   context = CALLOC_STRUCT(ps4gl_context);
+   if (!context) {
+      set_error("out of memory");
+      return NULL;
+   }
+   memset(&attribs, 0, sizeof(attribs));
+   attribs.profile = es ? API_OPENGLES2 : API_OPENGL_CORE;
+   attribs.major = major;
+   attribs.minor = minor;
+   if (debug)
+      attribs.flags |= ST_CONTEXT_FLAG_DEBUG;
+   attribs.visual = window->visual;
+   attribs.options = options;
+   context->st = st_api_create_context(&screen, &attribs, &error, NULL);
+   if (!context->st) {
+      set_error("st_api_create_context failed (%d) for %s %d.%d", (int)error, es ? "OpenGL ES" : "OpenGL",
+                major, minor);
+      FREE(context);
+      return NULL;
+   }
+   context->window = window;
+   return context;
+}
+
+bool
+ps4gl_make_current(struct ps4gl_context *context)
+{
+   if (!context)
+      return st_api_make_current(NULL, NULL, NULL);
+   return st_api_make_current(context->st, &context->window->base, &context->window->base);
+}
+
+/* after the frame's last commands, before the flush: the back buffer made
+ * ready to present (dri_drawable.c's notify_before_flush_cb) */
+static void
+before_flush(void *data)
+{
+   struct ps4gl_context *context = data;
+   struct pipe_context *pipe = context->st->pipe;
+
+   pipe->flush_resource(pipe, context->window->textures[ST_ATTACHMENT_BACK_LEFT]);
+}
+
+void
+ps4gl_swap_buffers(struct ps4gl_context *context)
+{
+   struct ps4gl_window *window;
+   struct pipe_screen *pscreen = screen.screen;
+   struct pipe_resource *back;
+   struct pipe_fence_handle *fence = NULL;
+
+   if (!context)
+      return;
+   window = context->window;
+   back = window->textures[ST_ATTACHMENT_BACK_LEFT];
+   if (!back)
+      return;
+   _mesa_glthread_finish(context->st->ctx);
+   if (window->flushing)
+      return;
+   window->flushing = true;
+   st_context_flush(context->st, ST_FLUSH_END_OF_FRAME, &fence, before_flush, context);
+   window->flushing = false;
+   /* one frame in flight: wait for the previous one (dri_flush's throttle) */
+   if (window->throttle_fence) {
+      pscreen->fence_finish(pscreen, NULL, window->throttle_fence, OS_TIMEOUT_INFINITE);
+      pscreen->fence_reference(pscreen, &window->throttle_fence, NULL);
+   }
+   window->throttle_fence = fence;
+   pscreen->flush_frontbuffer(pscreen, context->st->pipe, back, 0, 0, window, 0, NULL);
+   /* the next frame validates the framebuffer again (the next image) */
+   p_atomic_inc(&window->base.stamp);
+}
+
+void
+ps4gl_set_swap_interval(struct ps4gl_context *context, int interval)
+{
+   struct ps4gl_window *window;
+
+   if (!context)
+      return;
+   window = context->window;
+   window->info.initial_swap_interval = interval;
+   if (window->textures[ST_ATTACHMENT_BACK_LEFT])
+      zink_kopper_set_swap_interval(screen.screen, window->textures[ST_ATTACHMENT_BACK_LEFT], interval);
+}
+
+void *
+ps4gl_get_proc_address(const char *name)
+{
+   return (void *)_mesa_glapi_get_proc_address(name);
+}
diff --git a/src/gallium/frontends/ps4/ps4_gl.h b/src/gallium/frontends/ps4/ps4_gl.h
new file mode 100644
index 0000000..f450eea
--- /dev/null
+++ b/src/gallium/frontends/ps4/ps4_gl.h
@@ -0,0 +1,66 @@
+/*
+ * Copyright 2026 OpenCE PS4 contributors
+ * SPDX-License-Identifier: MIT
+ */
+
+/*
+ * PS4: OpenGL (ES) contexts on Zink, the only GL the PS4 can have (its own,
+ * Piglet, cannot compile shaders on retail consoles). Zink draws through RADV,
+ * which the app links statically, and presents through a kopper swapchain on a
+ * Vulkan headless surface that the app's window system puts on VideoOut
+ * (zink_kopper.c, KOPPER_HEADLESS). The app hands Zink its Vulkan entry point
+ * by defining zink_ps4_vk_get_instance_proc_addr().
+ *
+ * One window (the screen) and the contexts made for it; every call but
+ * ps4gl_swap_buffers is made rarely, from any thread.
+ */
+
+#ifndef PS4_GL_H
+#define PS4_GL_H
+
+#include <stdbool.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+struct ps4gl_window;
+struct ps4gl_context;
+
+/* the app's vkGetInstanceProcAddr (a PFN_vkGetInstanceProcAddr), with its
+ * VK_EXT_headless_surface and VK_KHR_swapchain */
+void *zink_ps4_vk_get_instance_proc_addr(void);
+
+/* creates Zink's screen (the Vulkan instance and device); false if Zink cannot
+ * run, with the reason in ps4gl_error() */
+bool ps4gl_initialize(void);
+
+/* the window of width x height pixels (the swapchain's size): RGBA8 colour,
+ * with a depth/stencil buffer when depth_bits or stencil_bits */
+struct ps4gl_window *ps4gl_create_window(unsigned width, unsigned height, int depth_bits, int stencil_bits);
+
+/* an OpenGL ES context (es is true; the newest version Zink offers, at least
+ * major.minor) or a core profile one, drawing to window */
+struct ps4gl_context *ps4gl_create_context(struct ps4gl_window *window, bool es, int major, int minor, bool debug);
+
+/* binds context and its window to the calling thread (NULL unbinds) */
+bool ps4gl_make_current(struct ps4gl_context *context);
+
+/* presents the back buffer: flushes the context bound to this thread, waits
+ * for the previous frame's GPU work (one frame in flight) and queues the
+ * present */
+void ps4gl_swap_buffers(struct ps4gl_context *context);
