@@ -47,7 +47,7 @@ struct ps4gl_context *ps4gl_create_context(struct ps4gl_window *window, bool es,
 bool ps4gl_make_current(struct ps4gl_context *context);
 
 /* presents the back buffer: flushes the context bound to this thread, waits
- * for the previous frame's GPU work (one frame in flight) and queues the
+ * for the GPU work of the frame two back (two frames in flight) and queues the
  * present */
 void ps4gl_swap_buffers(struct ps4gl_context *context);
 
