+
+/* a glob of * and ? (what the platform layer's patterns are) */
+static int glob_match(const char *pattern, const char *name, int ignore_case)
+{
+	for (;;)
+	{
+		if (*pattern == '*')
+		{
+			pattern++;
+			if (!*pattern)
+				return 1;
+			for (; *name; name++)
+			{
+				if (glob_match(pattern, name, ignore_case))
+					return 1;
+			}
+			return 0;
+		}
+		if (!*name)
+			return !*pattern;
+		if (*pattern != '?')
+		{
+			int a = (unsigned char)*pattern, b = (unsigned char)*name;
+
+			if (ignore_case)
+			{
+				a = a >= 'A' && a <= 'Z' ? a + 32 : a;
+				b = b >= 'A' && b <= 'Z' ? b + 32 : b;
+			}
+			if (a != b)
+				return 0;
+		}
+		pattern++;
+		name++;
+	}
+}
+
+/* the names in path matching pattern: one allocation (the pointers, then
+the strings), as SDL's */
+char **SDL_GlobDirectory(const char *path, const char *pattern, SDL_GlobFlags flags, int *count)
+{
+	DIR *directory = opendir(path);
+	struct dirent *entry;
+	size_t pointers = 0, bytes = 0;
+	char **result;
+	char *strings;
+	int found = 0;
+
+	if (count)
+		*count = 0;
+	if (!directory)
+		return NULL;
+	while ((entry = readdir(directory)) != NULL)
+	{
+		if (!strcmp(entry->d_name, ".") || !strcmp(entry->d_name, ".."))
+			continue;
+		if (pattern && !glob_match(pattern, entry->d_name, (flags & SDL_GLOB_CASEINSENSITIVE) != 0))
+			continue;
+		pointers++;
+		bytes += strlen(entry->d_name) + 1;
+	}
+	result = malloc((pointers + 1) * sizeof(char *) + bytes);
+	if (!result)
+	{
+		closedir(directory);
+		return NULL;
+	}
+	strings = (char *)(result + pointers + 1);
+	rewinddir(directory);
+	while ((entry = readdir(directory)) != NULL && (size_t)found < pointers)
+	{
+		size_t length;
+
+		if (!strcmp(entry->d_name, ".") || !strcmp(entry->d_name, ".."))
+			continue;
+		if (pattern && !glob_match(pattern, entry->d_name, (flags & SDL_GLOB_CASEINSENSITIVE) != 0))
+			continue;
+		length = strlen(entry->d_name) + 1;
+		memcpy(strings, entry->d_name, length);
+		result[found++] = strings;
+		strings += length;
+	}
+	result[found] = NULL;
+	closedir(directory);
+	if (count)
+		*count = found;
+	return result;
+}
