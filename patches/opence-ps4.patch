+			S_ISREG(information.st_mode) ? SDL_PATHTYPE_FILE : SDL_PATHTYPE_OTHER;
+		info->size = (Uint64)information.st_size;
+		info->modify_time = (SDL_Time)information.st_mtime * 1000000000;
+		info->access_time = (SDL_Time)information.st_atime * 1000000000;
+		info->create_time = (SDL_Time)information.st_ctime * 1000000000;
