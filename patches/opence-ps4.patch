+		{
+			uint32_t part = size - done < 256 ? size - done : 256;
+
+			if (getentropy(buffer + done, part) != 0)
+				return done ? (long)done : -G_EIO;
+			done += part;
+		}
+		return (long)size;
+	}
+
+	case GUEST_SYS_mmap:
+		return host_guest_mmap((uint64_t)(uint32_t)a, (uint64_t)(uint32_t)b, (int)c, (int)d, (int)e, f);
+	case GUEST_SYS_munmap:
+		return host_guest_munmap((uint64_t)(uint32_t)a, (uint64_t)(uint32_t)b);
+	case GUEST_SYS_mprotect:
+		return host_guest_mprotect((uint64_t)(uint32_t)a, (uint64_t)(uint32_t)b, (int)c);
+	case GUEST_SYS_madvise:
+	case GUEST_SYS_membarrier:
+		return 0;
+	case GUEST_SYS_mremap:
+	case GUEST_SYS_brk:
+		/* musl then falls back to mmap and copying */
+		return -G_ENOMEM;
+
+	case GUEST_SYS_exit:
+	case GUEST_SYS_exit_group:
+		host_exit((int)a);
+
+	case GUEST_SYS_set_tid_address:
+	case GUEST_SYS_gettid:
+		return host_thread_id();
+	case GUEST_SYS_getpid:
+	case GUEST_SYS_getppid:
+		return 1;
+	case GUEST_SYS_getuid:
+	case GUEST_SYS_geteuid:
+	case GUEST_SYS_getgid:
+	case GUEST_SYS_getegid:
+		return 0;
+	case GUEST_SYS_kill:
+	case GUEST_SYS_tkill:
+	case GUEST_SYS_tgkill:
+	{
+		int signal_number = (int)(number == GUEST_SYS_tgkill ? c : b);
+		char reason[64];
+
+		if (!signal_number)
+			return 0;
+		snprintf(reason, sizeof(reason), "the game raised signal %d%s", signal_number,
+			signal_number == G_SIGABRT ? " (abort)" : "");
+		host_abort(reason);
+	}
+	case GUEST_SYS_rt_sigaction:
+	case GUEST_SYS_rt_sigprocmask:
+	case GUEST_SYS_sigaltstack:
+		/* the host owns signal handling */
+		return 0;
+	case GUEST_SYS_ioctl:
+		return -G_ENOTTY;
+	case GUEST_SYS_uname:
+	{
+		struct guest_utsname *result = GUEST(struct guest_utsname *, a);
+
+		memset(result, 0, sizeof(*result));
+		strcpy(result->sysname, "Linux");
+		strcpy(result->nodename, "ps4");
+		strcpy(result->release, "6.0.0");
+		strcpy(result->version, "OpenCE PS4");
+		strcpy(result->machine, "x86_64");
+		return 0;
+	}
+	case GUEST_SYS_sysinfo:
+	{
+		struct guest_sysinfo *result = GUEST(struct guest_sysinfo *, a);
+		uint64_t free_bytes = host_direct_memory_free();
+
+		memset(result, 0, sizeof(*result));
+		result->mem_unit = 4096;
+		result->totalram = (uint32_t)((4ULL << 30) / 4096);
+		result->freeram = (uint32_t)(free_bytes / 4096);
+		result->procs = 16;
+		return 0;
+	}
+	case GUEST_SYS_sched_getaffinity:
+	{
+		uint8_t *mask = GUEST(uint8_t *, c);
+		uint32_t size = (uint32_t)b < 8 ? (uint32_t)b : 8;
+
+		if (!size)
+			return -G_EINVAL;
+		memset(mask, 0, size);
+		/* the game's cores of the PS4's seven */
+		mask[0] = 0x3f;
+		return size;
+	}
+	case GUEST_SYS_prlimit64:
+	case GUEST_SYS_getrlimit:
+	{
+		/* everything unlimited */
+		uint64_t address = (uint64_t)(number == GUEST_SYS_prlimit64 ? d : b);
+
+		if (address)
+		{
+			if (number == GUEST_SYS_prlimit64)
+			{
+				uint64_t *limits = GUEST(uint64_t *, address);
+
+				limits[0] = limits[1] = ~0ULL;
+			}
+			else
+			{
+				uint32_t *limits = GUEST(uint32_t *, address);
+
+				limits[0] = limits[1] = ~0u;
+			}
+		}
+		return 0;
+	}
+	case GUEST_SYS_statx:
+	case GUEST_SYS_statfs:
+	case GUEST_SYS_fstatfs:
+	case GUEST_SYS_clone:
+	case GUEST_SYS_clone3:
+	case GUEST_SYS_execve:
+	case GUEST_SYS_pipe2:
+	case GUEST_SYS_rt_sigtimedwait:
+	case GUEST_SYS_pselect6:
+	case GUEST_SYS_epoll_pwait:
+	case GUEST_SYS_sendmsg:
+	case GUEST_SYS_recvmsg:
+	case GUEST_SYS_timer_create:
+	case GUEST_SYS_timer_settime:
+	case GUEST_SYS_timer_gettime:
+	case GUEST_SYS_setitimer:
+	case GUEST_SYS_getitimer:
+	case GUEST_SYS_times:
+	case GUEST_SYS_getrusage:
+	case GUEST_SYS_wait4:
+	case GUEST_SYS_waitid:
+		return -G_ENOSYS;
+
+	default:
+		host_logf(HOST_LOG_WARN, "guest system call %lld is not supported", number);
+		return -G_ENOSYS;
+	}
+}
+
+static uint64_t now_microseconds(void)
+{
+	struct timespec now;
+
+	clock_gettime(CLOCK_MONOTONIC, &now);
+	return (uint64_t)now.tv_sec * 1000000 + (uint64_t)now.tv_nsec / 1000;
+}
+
+long long host_syscall(long long number, long long a, long long b, long long c,
+	long long d, long long e, long long f)
+{
+	uint64_t start;
+	long long result;
+
+	switch (number)
+	{
+	/* (descriptor first) everything else done with a file waits for its
+	writes on the writer thread */
+	case GUEST_SYS_read:
+	case GUEST_SYS_pread64:
+	case GUEST_SYS_readv:
+	case GUEST_SYS_preadv:
+	case GUEST_SYS_writev:
+	case GUEST_SYS_pwritev:
+	case GUEST_SYS_close:
+	case GUEST_SYS_lseek:
+	case GUEST_SYS_fstat:
+	case GUEST_SYS_ftruncate:
+	case GUEST_SYS_fcntl:
+	case GUEST_SYS_dup:
+	case GUEST_SYS_dup3:
+		write_wait((int)a);
+		break;
+	/* waits that are meant to take long */
+	case GUEST_SYS_futex:
+	case GUEST_SYS_nanosleep:
+	case GUEST_SYS_clock_nanosleep:
+	case GUEST_SYS_ppoll:
+	case GUEST_SYS_sched_yield:
+		return dispatch(number, a, b, c, d, e, f);
+	default:
+		break;
+	}
+	start = now_microseconds();
+	result = dispatch(number, a, b, c, d, e, f);
+	start = now_microseconds() - start;
+	if (start >= 30000)
+		host_logf(HOST_LOG_WARN, "slow: system call %lld (%llx, %llx, %llx) took %llu ms", number,
+			(unsigned long long)a, (unsigned long long)b, (unsigned long long)c,
+			(unsigned long long)(start / 1000));
+	return result;
+}
diff --git a/port/ps4/host/host_thread.c b/port/ps4/host/host_thread.c
new file mode 100644
index 00000000..8f8a02d9
--- /dev/null
+++ b/port/ps4/host/host_thread.c
@@ -0,0 +1,223 @@
+/*
+HOST_THREAD.C
+
+Threads that run guest code (Android's host_thread.c, for the PS4).
+
+Guest (x32) code keeps stack addresses in 32-bit registers, so every thread
+that runs it needs its stack in guest memory: every such thread is created
+here, with its stack given to pthread_create. On the PS4 that also spares the
+threads the 8 MB stacks the system would take from flexible memory (the SMW
+port's v00.01 ran out of it). The guest's thread pointer (its musl struct
+pthread) is kept per thread in host TLS. Thread stacks are freed by a reaper
+thread once the thread has fully exited.
+*/
+
+#include "host.h"
+
+#include <errno.h>
+#include <pthread.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/mman.h>
+#include <unistd.h>
+
+int32_t ps4_pthread_rename(void *thread, const char *name) __asm__("scePthreadRename");
+void *ps4_pthread_self(void) __asm__("scePthreadSelf");
+
+#define GUARD_SIZE 0x4000
+#define MINIMUM_STACK_SIZE (4 * 1024 * 1024)
+
+static __thread uint32_t guest_tp;
+static __thread int thread_id;
+static int next_thread_id = 1;
+
+uint32_t host_get_tp(void)
+{
+	return guest_tp;
+}
+
+void host_set_tp(uint32_t thread)
+{
+	guest_tp = thread;
+}
+
+int host_thread_id(void)
+{
+	if (!thread_id)
+		thread_id = __sync_fetch_and_add(&next_thread_id, 1);
+	return thread_id;
+}
+
+/* ---------- stacks */
+
+static void *stack_allocate(size_t size, void **mapping, size_t *mapping_size)
+{
+	size_t total = size + GUARD_SIZE;
+	void *base = host_low_map(total, PROT_READ | PROT_WRITE);
+
+	if (!base)
+		return NULL;
+	/* guard page at the bottom (a PS4 page: 16 KB) */
+	mprotect(base, GUARD_SIZE, PROT_NONE);
+	*mapping = base;
+	*mapping_size = total;
+	return (char *)base + GUARD_SIZE;
+}
+
+static int on_guest_stack(void)
+{
+	uint64_t sp = (uint64_t)(uintptr_t)__builtin_frame_address(0);
+
+	return sp < 0x100000000ULL;
+}
+
+/* ---------- calling into the guest */
+
+typedef uint32_t (*guest_function)(uint32_t, uint32_t, uint32_t, uint32_t);
+
+uint32_t host_call_guest(uint32_t function, uint32_t a, uint32_t b, uint32_t c, uint32_t d)
+{
+	if (!on_guest_stack())
+		host_fatal("guest code called on a thread without a guest stack");
+	if (!guest_tp)
+		((guest_function)(uintptr_t)host_image.header->thread_attach)(0, 0, 0, 0);
+	return ((guest_function)(uintptr_t)function)(a, b, c, d);
+}
+
+void host_run_guest_main(uint32_t boot)
+{
+	((void (*)(uint32_t))(uintptr_t)host_image.header->start)(boot);
+	host_fatal("the guest returned from __guest_start");
+}
+
+/* ---------- guest threads */
+
+struct thread_start
+{
+	void *(*function)(void *);
+	void *argument;
+	void *mapping;
+	size_t mapping_size;
+	char name[32];
+};
+
+struct finished_thread
+{
+	struct finished_thread *next;
+	pthread_t thread;
+	void *mapping;
+	size_t mapping_size;
+};
+
+static pthread_mutex_t reaper_lock = PTHREAD_MUTEX_INITIALIZER;
+static pthread_cond_t reaper_condition = PTHREAD_COND_INITIALIZER;
+static struct finished_thread *finished_threads;
+static int reaper_started;
+
+static void *reaper(void *unused)
+{
+	(void)unused;
+	for (;;)
+	{
+		struct finished_thread *finished;
+
+		pthread_mutex_lock(&reaper_lock);
+		while (!finished_threads)
+			pthread_cond_wait(&reaper_condition, &reaper_lock);
+		finished = finished_threads;
+		finished_threads = finished->next;
+		pthread_mutex_unlock(&reaper_lock);
+		pthread_join(finished->thread, NULL);
+		host_low_unmap(finished->mapping, finished->mapping_size);
+		free(finished);
+	}
+	return NULL;
+}
+
+static void *thread_main(void *context)
+{
+	struct thread_start start = *(struct thread_start *)context;
+	struct finished_thread *finished;
+
+	free(context);
+	if (start.name[0])
+		ps4_pthread_rename(ps4_pthread_self(), start.name);
+	host_debug_thread_started(start.name);
+	start.function(start.argument);
+	/* (a thread the guest made has let its struct pthread go by now; one
+	of the host's that ran guest code, the audio thread, has it still) */
+	if (guest_tp)
+		((guest_function)(uintptr_t)host_image.header->thread_detach)(0, 0, 0, 0);
+	host_debug_thread_exited();
+	guest_tp = 0;
+
+	finished = calloc(1, sizeof(*finished));
+	finished->thread = pthread_self();
+	finished->mapping = start.mapping;
+	finished->mapping_size = start.mapping_size;
+	pthread_mutex_lock(&reaper_lock);
+	finished->next = finished_threads;
+	finished_threads = finished;
+	pthread_cond_signal(&reaper_condition);
+	pthread_mutex_unlock(&reaper_lock);
+	return NULL;
+}
+
+int host_native_thread_create(void *(*function)(void *), void *argument, size_t stack_size, const char *name)
+{
+	struct thread_start *start = calloc(1, sizeof(*start));
+	pthread_attr_t attributes;
+	pthread_t thread;
+	void *stack;
+	int error;
+
+	if (!start)
+		return ENOMEM;
+	pthread_mutex_lock(&reaper_lock);
+	if (!reaper_started)
+	{
+		pthread_t reaper_thread;
+
+		if (pthread_create(&reaper_thread, NULL, reaper, NULL) == 0)
+			reaper_started = 1;
+	}
+	pthread_mutex_unlock(&reaper_lock);
+
+	/* the PS4 runtime's pthread_create raises any smaller stack size to
+	4 MB (port/ps4_runtime.cpp), which on a stack of ours would run the
+	thread past its end */
+	if (stack_size < MINIMUM_STACK_SIZE)
+		stack_size = MINIMUM_STACK_SIZE;
+	stack_size = (stack_size + 0xffff) & ~(size_t)0xffff;
+	stack = stack_allocate(stack_size, &start->mapping, &start->mapping_size);
+	if (!stack)
+	{
+		free(start);
+		return EAGAIN;
+	}
+	start->function = function;
+	start->argument = argument;
+	snprintf(start->name, sizeof(start->name), "%s", name ? name : "");
+	pthread_attr_init(&attributes);
+	pthread_attr_setstack(&attributes, stack, stack_size);
+	error = pthread_create(&thread, &attributes, thread_main, start);
+	pthread_attr_destroy(&attributes);
+	if (error)
+	{
+		host_logf(HOST_LOG_ERROR, "cannot start thread %s (%d)", start->name, error);
+		host_low_unmap(start->mapping, start->mapping_size);
+		free(start);
+	}
+	return error;
+}
+
+static void *guest_thread_main(void *guest_thread)
+{
+	host_call_guest(host_image.header->thread_start, (uint32_t)(uintptr_t)guest_thread, 0, 0, 0);
+	return NULL;
+}
+
+int host_thread_create(uint32_t guest_thread, uint32_t stack_size)
+{
+	return host_native_thread_create(guest_thread_main, (void *)(uintptr_t)guest_thread, stack_size, "guest");
+}
