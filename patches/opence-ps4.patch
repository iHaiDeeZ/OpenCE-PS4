+layouts, so every system call musl makes goes to the runtime's dispatcher
+(port/android/guest/runtime/guest_syscall.c), which performs it through
+the host. The numbers are the generic Linux ones (bits/syscall.h.in, as
+AArch64's), which the PS4 host translates (port/ps4/host/host_syscall.c). */
+#define __SYSCALL_LL_E(x) (x)
+#define __SYSCALL_LL_O(x) (x)
+
+#define __scc(X) sizeof(1?(X):0ULL) < 8 ? (unsigned long) (X) : (long long) (X)
+typedef long long syscall_arg_t;
+
+long __guest_syscall(long long, long long, long long, long long, long long, long long, long long);
+
+static __inline long __syscall0(long long n)
+{
+	return __guest_syscall(n, 0, 0, 0, 0, 0, 0);
+}
+
+static __inline long __syscall1(long long n, long long a)
+{
+	return __guest_syscall(n, a, 0, 0, 0, 0, 0);
+}
+
+static __inline long __syscall2(long long n, long long a, long long b)
+{
+	return __guest_syscall(n, a, b, 0, 0, 0, 0);
+}
+
+static __inline long __syscall3(long long n, long long a, long long b, long long c)
+{
+	return __guest_syscall(n, a, b, c, 0, 0, 0);
+}
+
+static __inline long __syscall4(long long n, long long a, long long b, long long c, long long d)
+{
+	return __guest_syscall(n, a, b, c, d, 0, 0);
+}
+
+static __inline long __syscall5(long long n, long long a, long long b, long long c, long long d, long long e)
+{
+	return __guest_syscall(n, a, b, c, d, e, 0);
+}
+
+static __inline long __syscall6(long long n, long long a, long long b, long long c, long long d, long long e, long long f)
+{
+	return __guest_syscall(n, a, b, c, d, e, f);
+}
+
+#define SYSCALL_NO_TLS 1
+#define IPC_64 0
diff --git a/port/ps4/host/host.h b/port/ps4/host/host.h
new file mode 100644
index 00000000..4390e6d0
--- /dev/null
+++ b/port/ps4/host/host.h
@@ -0,0 +1,143 @@
+/*
+HOST.H
+
+Internals of the PS4 port's host (the eboot). See port/ps4/README.md for the
+design and port/android/include/halo_android_abi.h for the guest contract,
+which the PS4's x32 guest shares with Android's.
+*/
+
+#ifndef __HALO_PS4_HOST_H
+#define __HALO_PS4_HOST_H
+
+#include <stdarg.h>
+#include <stddef.h>
+#include <stdint.h>
+#include <stdio.h>
+
+#include "halo_android_abi.h"
+
+/* the package's version (set by the build) */
+#ifndef OPENCE_PS4_VERSION
+#define OPENCE_PS4_VERSION "00.00"
+#endif
+
+/* ---------- where the game keeps its files */
+
+#define HOST_DATA_ROOT "/data/OpenCE"
+#define HOST_SAVE_ROOT HOST_DATA_ROOT "/save"
+/* the guest image and the files beside it in the package */
+#define HOST_PACKAGE_ROOT "/app0"
+
+/* ---------- logging (HOST_DATA_ROOT/host.log) */
+
+void host_logf(int priority, const char *format, ...) __attribute__((format(printf, 2, 3)));
+#define HOST_LOG_INFO 4
+#define HOST_LOG_WARN 5
+#define HOST_LOG_ERROR 6
+void host_log(int priority, const char *text);
+/* guest services also used inside the host */
+void host_exit(int code) __attribute__((noreturn));
+void host_abort(const char *reason) __attribute__((noreturn));
+int host_errno(void);
+
+/* logs and terminates */
+void host_fatal(const char *format, ...) __attribute__((format(printf, 1, 2), noreturn));
+
+/* port/ps4_crashlog.cpp: a startup milestone in boot-trace.log */
+void ps4_boot_trace(const char *stage);
+
+/* ---------- guest memory (host_memory.c)
+
+All memory the guest can address lies below 4 GB: the Xbox window and the
+image at their fixed addresses, and pools for everything else (the guest's
+malloc arenas, thread stacks, anonymous mappings). The PS4 has no demand-zero
+anonymous memory to speak of (flexible memory is a few hundred MB): the
+guest's memory is direct memory, mapped in 64 KB chunks when handed out. */
+
+/* reserves the fixed ranges and the pools' address space; returns 0 on
+success */
+int host_memory_initialize(void);
+/* maps the image's range [base, base + size): its first code_size bytes
+(the code and the read-only data) readable, writable and executable, the rest
+writable; returns 0 on success */
+int host_memory_map_image(uint32_t base, uint32_t code_size, uint32_t size);
+/* lists the mappings below 4 GB in the log */
+void host_memory_report_low_mappings(void);
+/* write tracking by page contents instead of page faults (host_watch_hash.h);
+call before the guest starts */
+void host_memory_watch_use_hashes(void);
+/* page-granular allocations below 4 GB, zeroed; NULL on failure */
+void *host_low_map(size_t size, int protection);
+void host_low_unmap(void *address, size_t size);
+/* 1 if [address, address + size) was handed out by host_low_map or is one of
+the fixed ranges */
+int host_low_owns(uintptr_t address, size_t size);
+/* the guest's mmap/munmap/mprotect (host_syscall.c), Linux flags and errors */
+long host_guest_mmap(uint64_t address, uint64_t size, int protection, int flags, int fd, int64_t offset);
+long host_guest_munmap(uint64_t address, uint64_t size);
+long host_guest_mprotect(uint64_t address, uint64_t size, int protection);
+/* makes watched pages in [address, address + size) writable before the
+host (or a system call) writes there: the kernel's copies fail with EFAULT
+on protected pages instead of faulting */
+void host_memory_prepare_write(uint64_t address, uint64_t size);
+/* the fault handlers (crash reports for everything else) */
+void host_install_signal_handlers(void);
+/* direct memory still free, in bytes */
+uint64_t host_direct_memory_free(void);
+
+/* waits for the large writes still being made (host_syscall.c) */
+void host_syscall_flush(void);
+
+/* ---------- the guest image (host_loader.c) */
+
+struct host_guest_image
+{
+	const struct halo_guest_header *header;
+	uint32_t base, end;
+};
+
+extern struct host_guest_image host_image;
+
+/* maps the image from the ELF file in memory; returns 0 on success */
+int host_load_image(const void *elf, size_t size);
+
+/* ---------- entering guest code (host_thread.c) */
+
+/* calls the guest function at address with up to four 32-bit arguments on
+this thread, which must have been made by host_native_thread_create (giving
+the thread a guest struct pthread first if it has none); returns the guest's
+eax */
+uint32_t host_call_guest(uint32_t function, uint32_t a, uint32_t b, uint32_t c, uint32_t d);
+/* starts a thread running function(argument) with its stack in guest
+memory, so that it can call guest code; the stack is freed after it exits.
+Returns 0 or an errno value */
+int host_native_thread_create(void *(*function)(void *), void *argument, size_t stack_size, const char *name);
+/* runs the guest's __guest_start on the calling thread (one made by
+host_native_thread_create); does not return */
+void host_run_guest_main(uint32_t boot) __attribute__((noreturn));
+/* this thread's small id, the guest's gettid() */
+int host_thread_id(void);
+
+/* ---------- the import table (generated: build/ps4/host/host_import_table.c) */
+
+void *host_resolve_import(const char *name);
+
+/* ---------- SDL and OpenGL (host_sdl.c, host_gl.c) */
+
+void *host_gl_resolve(const char *name);
+/* the swapchain's size (VideoOut's 1080p) */
+#define HOST_SCREEN_WIDTH 1920
+#define HOST_SCREEN_HEIGHT 1080
+/* reads the pads once a frame (host_sdl.c), from the frame's swap */
+void host_sdl_frame(void);
+/* the shaders compiled and programs linked since the last call (host_gl.c) */
+void host_gl_frame_counts(unsigned *compiled, unsigned *linked);
+/* whether GL calls run on Mesa's glthread (host_gl.c) */
+int host_gl_threaded(void);
+
+/* ---------- debugging (host_debug.c) */
+
+void host_debug_thread_started(const char *name);
+void host_debug_thread_exited(void);
+
+#endif
diff --git a/port/ps4/host/host_debug.c b/port/ps4/host/host_debug.c
new file mode 100644
index 00000000..8fe95841
--- /dev/null
+++ b/port/ps4/host/host_debug.c
@@ -0,0 +1,69 @@
+/*
+HOST_DEBUG.C
+
+Fault reports for the PS4 port: a fault that is not the write tracking's
+(host_memory.c) is written to the log with the registers and the guest's
+frame chain, before the crash handler of the PS4 runtime (crash.log) takes
+over. Guest addresses are the image's own: symbolize them with
+llvm-symbolizer --obj=build/ps4/halo_guest.elf.
+*/
+
+#include "host.h"
+
+#include <signal.h>
+#include <string.h>
+#include <ucontext.h>
+
+static __thread const char *thread_name;
+
+void host_debug_thread_started(const char *name)
+{
+	thread_name = name;
+}
+
+void host_debug_thread_exited(void)
+{
+	thread_name = NULL;
+}
+
+static int in_image(uint64_t address)
+{
+	return address >= host_image.base && address < host_image.end;
+}
+
+void host_debug_report_fault(int signal_number, siginfo_t *information, void *context)
+{
+	const ucontext_t *ucontext = context;
+	const mcontext_t *registers = &ucontext->uc_mcontext;
+	uint64_t rip = (uint64_t)registers->mc_rip, rbp = (uint64_t)registers->mc_rbp;
+	int index;
+
+	host_logf(HOST_LOG_ERROR, "signal %d at address %p on thread %s: rip %016llx rsp %016llx rbp %016llx%s",
+		signal_number, information->si_addr, thread_name ? thread_name : "?", (unsigned long long)rip,
+		(unsigned long long)registers->mc_rsp, (unsigned long long)rbp,
+		in_image(rip) ? " (in the game: llvm-symbolizer --obj=halo_guest.elf)" : "");
+	host_logf(HOST_LOG_ERROR, "  rax %016llx rbx %016llx rcx %016llx rdx %016llx",
+		(unsigned long long)registers->mc_rax, (unsigned long long)registers->mc_rbx,
+		(unsigned long long)registers->mc_rcx, (unsigned long long)registers->mc_rdx);
+	host_logf(HOST_LOG_ERROR, "  rsi %016llx rdi %016llx r8  %016llx r9  %016llx",
+		(unsigned long long)registers->mc_rsi, (unsigned long long)registers->mc_rdi,
+		(unsigned long long)registers->mc_r8, (unsigned long long)registers->mc_r9);
+	host_logf(HOST_LOG_ERROR, "  r10 %016llx r11 %016llx r12 %016llx r13 %016llx",
+		(unsigned long long)registers->mc_r10, (unsigned long long)registers->mc_r11,
+		(unsigned long long)registers->mc_r12, (unsigned long long)registers->mc_r13);
+	host_logf(HOST_LOG_ERROR, "  r14 %016llx r15 %016llx err %llx",
+		(unsigned long long)registers->mc_r14, (unsigned long long)registers->mc_r15,
+		(unsigned long long)registers->mc_err);
+	/* the guest's frame records: the caller's rbp and the return address,
+	8 bytes each (x32 pushes them as 64-bit values) */
+	for (index = 0; index < 24 && rbp && rbp < 0x100000000ULL && (rbp & 7) == 0; index++)
+	{
+		const uint64_t *frame = (const uint64_t *)(uintptr_t)rbp;
+
+		if (!host_low_owns(rbp, 16))
+			break;
+		host_logf(HOST_LOG_ERROR, "  frame %2d: return %016llx%s", index, (unsigned long long)frame[1],
+			in_image(frame[1]) ? " (game)" : "");
+		rbp = frame[0];
+	}
+}
diff --git a/port/ps4/host/host_gl.c b/port/ps4/host/host_gl.c
new file mode 100644
index 00000000..66d5af33
--- /dev/null
+++ b/port/ps4/host/host_gl.c
@@ -0,0 +1,166 @@
+/*
+HOST_GL.C
+
+OpenGL ES for the guest, on the PS4: Mesa's, Zink on RADV, linked into the
+eboot (frontends/ps4 in the PS4 Mesa). The guest's generated entry points
+(guest_gl.c) import hostgl_<function>, resolved here to Mesa's dispatch
+functions (looked up by name: its public entry points miss some of OpenGL
+ES's); the arguments already have host types by then. The helpers are Android's
+(port/android/host/host_gl.c).
+*/
+
+#include "host.h"
+
+#include <GLES3/gl32.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include "ps4_gl.h"
+
+/* shader compiles and program links, counted for the hitch log (host_sdl.c) */
+static void (*real_compile_shader)(GLuint);
+static void (*real_link_program)(GLuint);
+static volatile unsigned shaders_compiled, programs_linked;
+
+static void counted_compile_shader(GLuint shader)
+{
+	__sync_fetch_and_add(&shaders_compiled, 1);
+	real_compile_shader(shader);
+}
+
+static void counted_link_program(GLuint program)
+{
+	__sync_fetch_and_add(&programs_linked, 1);
+	real_link_program(program);
+}
+
+void host_gl_frame_counts(unsigned *compiled, unsigned *linked)
+{
+	*compiled = __sync_lock_test_and_set(&shaders_compiled, 0);
+	*linked = __sync_lock_test_and_set(&programs_linked, 0);
+}
+
+int host_gl_threaded(void)
+{
+	const char *setting = getenv("mesa_glthread");
+
+	return !setting || (strcmp(setting, "false") && strcmp(setting, "0"));
+}
+
+void *host_gl_resolve(const char *name)
+{
+	/* the base-vertex extensions' entry points are the core function's */
+	if (!strcmp(name, "glDrawElementsBaseVertexEXT") || !strcmp(name, "glDrawElementsBaseVertexOES"))
+		name = "glDrawElementsBaseVertex";
+	if (!strcmp(name, "glCompileShader"))
+	{
+		real_compile_shader = ps4gl_get_proc_address(name);
+		return real_compile_shader ? (void *)counted_compile_shader : NULL;
+	}
+	if (!strcmp(name, "glLinkProgram"))
+	{
+		real_link_program = ps4gl_get_proc_address(name);
+		return real_link_program ? (void *)counted_link_program : NULL;
+	}
+	return ps4gl_get_proc_address(name);
+}
+
+void host_gl_get_string(uint32_t name, int index, char *buffer, uint32_t size)
+{
+	const GLubyte *text = index >= 0 ? glGetStringi(name, (GLuint)index) : glGetString(name);
+
+	if (!size)
+		return;
+	buffer[0] = 0;
+	if (text)
+	{
+		strncpy(buffer, (const char *)text, size - 1);
+		buffer[size - 1] = 0;
+	}
+}
+
+int host_gl_has_extension(const char *name)
+{
+	GLint count = 0, index;
+
+	glGetIntegerv(GL_NUM_EXTENSIONS, &count);
+	for (index = 0; index < count; index++)
+	{
+		const char *extension = (const char *)glGetStringi(GL_EXTENSIONS, (GLuint)index);
+
+		if (extension && !strcmp(extension, name))
+			return 1;
+	}
+	return 0;
+}
+
+/* copies size bytes of a buffer object (the snapshots of the visibility
+tests' counters, d3d8_gl.c) */
+void host_gl_read_buffer(uint32_t buffer, uint32_t offset, uint32_t size, void *data)
+{
+	const void *mapping;
+
+	host_memory_prepare_write((uint64_t)(uintptr_t)data, size);
+	glBindBuffer(GL_COPY_READ_BUFFER, buffer);
+	mapping = glMapBufferRange(GL_COPY_READ_BUFFER, offset, size, GL_MAP_READ_BIT);
+	if (mapping)
+	{
+		memcpy(data, mapping, size);
+		glUnmapBuffer(GL_COPY_READ_BUFFER);
+	}
+	else
+	{
+		memset(data, 0, size);
+	}
+	glBindBuffer(GL_COPY_READ_BUFFER, 0);
+}
+
+/* a ring of fences, one for each frame's streamed vertices and indices
+(as Android's) */
+#define FRAME_FENCE_SLOTS 8
+
+static GLsync frame_fences[FRAME_FENCE_SLOTS];
+
+void host_gl_fence_frame(uint32_t slot)
+{
+	if (slot >= FRAME_FENCE_SLOTS)
+		return;
+	if (frame_fences[slot])
+		glDeleteSync(frame_fences[slot]);
+	frame_fences[slot] = glFenceSync(GL_SYNC_GPU_COMMANDS_COMPLETE, 0);
+}
+
+void host_gl_wait_frame(uint32_t slot)
+{
+	if (slot >= FRAME_FENCE_SLOTS || !frame_fences[slot])
+		return;
+	/* at most a second: a lost device must not hang the game */
+	glClientWaitSync(frame_fences[slot], GL_SYNC_FLUSH_COMMANDS_BIT, 1000000000ull);
+	glDeleteSync(frame_fences[slot]);
+	frame_fences[slot] = NULL;
+}
+
+/* an unsynchronized write into the buffer bound to target (as Android's: no
+GL_MAP_INVALIDATE_RANGE_BIT, whose cost per call was ruinous on Adreno) */
+void host_gl_buffer_write(uint32_t target, uint32_t offset, uint32_t size, const void *data)
+{
+	void *mapping;
+
+	/* under glthread a mapping waits for its thread to catch up, where
+	glBufferSubData is queued with a copy of the data (the driver then writes
+	the range behind the GPU's work, as its threaded context does) */
+	if (host_gl_threaded())
+	{
+		glBufferSubData(target, offset, size, data);
+		return;
+	}
+	mapping = glMapBufferRange(target, offset, size, GL_MAP_WRITE_BIT | GL_MAP_UNSYNCHRONIZED_BIT);
+
+	if (!mapping)
+	{
+		glBufferSubData(target, offset, size, data);
+		return;
+	}
+	memcpy(mapping, data, size);
+	glUnmapBuffer(target);
+}
diff --git a/port/ps4/host/host_loader.c b/port/ps4/host/host_loader.c
new file mode 100644
index 00000000..2afb1a74
--- /dev/null
+++ b/port/ps4/host/host_loader.c
@@ -0,0 +1,151 @@
+/*
+HOST_LOADER.C
+
+Loads the guest image: a statically linked x32 ELF executable (ELFCLASS32,
+x86-64 code, built by tools/ps4_build.py) whose segments are copied to the
+addresses it was linked at, below 4 GB, in memory the PS4 lets an app run
+code from (host_memory_map_image). The image starts with a struct
+halo_guest_header naming its import table, which is filled with the host
+functions of the same names. (Android's host_loader.c, for this ELF class.)
+*/
+
+#include "host.h"
+
+#include <string.h>
+
+/* (spelled out: the PS4's headers have no 32-bit ELF types) */
+struct elf32_header
+{
+	unsigned char ident[16];
+	uint16_t type;
+	uint16_t machine;
+	uint32_t version;
+	uint32_t entry;
+	uint32_t program_header_offset;
+	uint32_t section_header_offset;
+	uint32_t flags;
+	uint16_t header_size;
+	uint16_t program_header_size;
+	uint16_t program_header_count;
+	uint16_t section_header_size;
+	uint16_t section_header_count;
+	uint16_t section_names_index;
+};
+
+struct elf32_program_header
+{
+	uint32_t type;
+	uint32_t offset;
+	uint32_t virtual_address;
+	uint32_t physical_address;
+	uint32_t file_size;
+	uint32_t memory_size;
+	uint32_t flags;
+	uint32_t alignment;
+};
+
+#define ELF_CLASS_32 1
+#define ELF_TYPE_EXECUTABLE 2
+#define ELF_MACHINE_X86_64 62
+#define ELF_SEGMENT_LOAD 1
+#define ELF_SEGMENT_EXECUTABLE 1
+#define ELF_SEGMENT_WRITABLE 2
+
+struct host_guest_image host_image;
+
+static void missing_import(void)
+{
+	host_fatal("the guest called a host function that is not available");
+}
+
+int host_load_image(const void *file, size_t size)
+{
+	const struct elf32_header *elf = file;
+	const struct elf32_program_header *segments;
+	uint64_t low = ~0ULL, high = 0;
+	uint64_t code_end = 0;
+	const struct halo_guest_header *header;
+	uint64_t *table;
+	const char *name;
+	uint32_t count, index;
+	int missing = 0;
+
+	if (size < sizeof(*elf) || memcmp(elf->ident, "\177ELF", 4) || elf->ident[4] != ELF_CLASS_32 ||
+		elf->machine != ELF_MACHINE_X86_64 || elf->type != ELF_TYPE_EXECUTABLE ||
+		(uint64_t)elf->program_header_offset + (uint64_t)elf->program_header_count * sizeof(*segments) > size)
+	{
+		host_logf(HOST_LOG_ERROR, "the guest image is not an x32 executable");
+		return -1;
+	}
+	segments = (const struct elf32_program_header *)((const char *)file + elf->program_header_offset);
+	for (index = 0; index < elf->program_header_count; index++)
+	{
+		if (segments[index].type != ELF_SEGMENT_LOAD)
+			continue;
+		if (segments[index].virtual_address < low)
+			low = segments[index].virtual_address;
+		if ((uint64_t)segments[index].virtual_address + segments[index].memory_size > high)
+			high = (uint64_t)segments[index].virtual_address + segments[index].memory_size;
+		/* the code and read-only data come first (port/ps4/guest/guest.ld),
+		then the writable data at a 64 KB boundary */
+		if (segments[index].flags & ELF_SEGMENT_EXECUTABLE || !(segments[index].flags & ELF_SEGMENT_WRITABLE) ||
+			segments[index].virtual_address == HALO_GUEST_IMAGE_BASE)
+		{
+			uint64_t end = (uint64_t)segments[index].virtual_address + segments[index].memory_size;
+
+			if (end > code_end)
+				code_end = end;
+		}
+	}
+	low &= ~0xfffULL;
+	high = (high + 0xfff) & ~0xfffULL;
+	if (low != HALO_GUEST_IMAGE_BASE || high > 0x100000000ULL)
+	{
+		host_logf(HOST_LOG_ERROR, "the guest image spans %llx-%llx", (unsigned long long)low, (unsigned long long)high);
+		return -1;
+	}
+	if (host_memory_map_image((uint32_t)low, (uint32_t)(code_end - low), (uint32_t)(high - low)) != 0)
+		return -1;
+	for (index = 0; index < elf->program_header_count; index++)
+	{
+		const struct elf32_program_header *segment = &segments[index];
+
+		if (segment->type != ELF_SEGMENT_LOAD)
+			continue;
+		if ((uint64_t)segment->offset + segment->file_size > size)
+			return -1;
+		memcpy((void *)(uintptr_t)segment->virtual_address, (const char *)file + segment->offset, segment->file_size);
+	}
+
+	header = (const struct halo_guest_header *)(uintptr_t)low;
+	if (header->magic != HALO_GUEST_MAGIC || header->abi_version != HALO_GUEST_ABI_VERSION)
+	{
+		host_logf(HOST_LOG_ERROR, "the guest image header does not match this host");
+		return -1;
+	}
+	host_image.header = header;
+	host_image.base = (uint32_t)low;
+	host_image.end = (uint32_t)high;
+
+	table = (uint64_t *)(uintptr_t)header->import_table;
+	name = (const char *)(uintptr_t)header->import_names;
+	count = *(const uint32_t *)(uintptr_t)header->import_count;
+	for (index = 0; index < count; index++)
+	{
+		void *function = host_resolve_import(name);
+
+		if (!function && !strncmp(name, "hostgl_", 7))
+			function = host_gl_resolve(name + 7);
+		if (!function)
+		{
+			host_logf(HOST_LOG_WARN, "guest import %s is not available", name);
+			function = (void *)missing_import;
+			missing++;
+		}
+		table[index] = (uint64_t)(uintptr_t)function;
+		name += strlen(name) + 1;
+	}
+	host_logf(HOST_LOG_INFO, "guest image %08llx-%08llx, %u imports (%d unavailable)",
+		(unsigned long long)low, (unsigned long long)high, count, missing);
+	return 0;
+}
diff --git a/port/ps4/host/host_main.c b/port/ps4/host/host_main.c
new file mode 100644
index 00000000..e76047a8
--- /dev/null
+++ b/port/ps4/host/host_main.c
@@ -0,0 +1,367 @@
+/*
+HOST_MAIN.C
+
+Entry point of the PS4 port (the eboot's main).
+
+It reserves the guest's memory below 4 GB, loads the guest image (the game,
+built as x32 code) from the package, gives it an environment describing
+where the game data and saves live, and runs its main() on a thread of its
+own with its stack in guest memory (host_thread.c). The main thread then
+only waits: the game ends the process itself (host_exit).
+
+Storage: the game data (the folder holding maps/) and the settings
+(config.toml) are in /data/OpenCE; saves in its save/ folder. A disc image
+(.iso) put there is extracted to maps/ at the first start (the platform
+layer's own extraction, port/linux/src/xiso.c).
+*/
+
+#include "host.h"
+
+#include <errno.h>
+#include <fcntl.h>
+#include <pthread.h>
+#include <stdarg.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/stat.h>
+#include <time.h>
+#include <unistd.h>
+
+int32_t ps4_usleep(uint32_t microseconds) __asm__("sceKernelUsleep");
+
+/* ---------- logging and termination */
+
+static int log_file = -1;
+static pthread_mutex_t log_file_lock = PTHREAD_MUTEX_INITIALIZER;
+
+static void log_write(int priority, const char *text)
+{
+	char line[1200];
+	struct timespec now;
+	int length;
+
+	clock_gettime(CLOCK_MONOTONIC, &now);
+	length = snprintf(line, sizeof(line), "%5ld.%03ld %s %s\n", (long)now.tv_sec, now.tv_nsec / 1000000L,
+		priority >= HOST_LOG_ERROR ? "E" : priority >= HOST_LOG_WARN ? "W" : "I", text);
+	if (length < 0)
+		return;
+	if (length > (int)sizeof(line) - 1)
+		length = (int)sizeof(line) - 1;
+	pthread_mutex_lock(&log_file_lock);
+	if (log_file < 0)
+	{
+		mkdir(HOST_DATA_ROOT, 0777);
+		log_file = open(HOST_DATA_ROOT "/opence.log", O_WRONLY | O_CREAT | O_TRUNC, 0666);
+	}
+	if (log_file >= 0)
+		write(log_file, line, (size_t)length);
+	pthread_mutex_unlock(&log_file_lock);
+}
+
+void host_log(int priority, const char *text)
+{
+	log_write(priority, text ? text : "");
+}
+
+void host_logf(int priority, const char *format, ...)
+{
+	char message[1024];
+	va_list arguments;
+
+	va_start(arguments, format);
+	vsnprintf(message, sizeof(message), format, arguments);
+	va_end(arguments);
+	log_write(priority, message);
+}
+
+void host_fatal(const char *format, ...)
+{
+	char message[1024];
+	va_list arguments;
+
+	va_start(arguments, format);
+	vsnprintf(message, sizeof(message), format, arguments);
+	va_end(arguments);
+	log_write(HOST_LOG_ERROR, message);
+	ps4_boot_trace(message);
+	_exit(1);
+}
+
+void host_abort(const char *reason)
+{
+	host_logf(HOST_LOG_ERROR, "guest abort: %s", reason);
+	ps4_boot_trace(reason);
+	abort();
+}
+
+void host_exit(int code)
+{
+	host_syscall_flush();
+	host_logf(HOST_LOG_INFO, "the game exited (%d)", code);
+	ps4_boot_trace("the game exited");
+	_exit(code);
+}
+
+int host_errno(void)
+{
+	return errno;
+}
+
+/* ---------- the guest's environment */
+
+#define ENVIRONMENT_MAXIMUM 64
+
+struct environment
+{
+	char *entries[ENVIRONMENT_MAXIMUM];
+	int count;
+};
+
+static void environment_set(struct environment *environment, const char *name, const char *value)
+{
+	size_t length = strlen(name);
+	char *entry = malloc(length + strlen(value) + 2);
+	int index;
+
+	sprintf(entry, "%s=%s", name, value);
+	for (index = 0; index < environment->count; index++)
+	{
+		if (!strncmp(environment->entries[index], name, length) && environment->entries[index][length] == '=')
+		{
+			free(environment->entries[index]);
+			environment->entries[index] = entry;
+			return;
+		}
+	}
+	if (environment->count < ENVIRONMENT_MAXIMUM)
+		environment->entries[environment->count++] = entry;
+	else
+		free(entry);
+}
+
+/* environment.txt in the data folder: NAME=value lines for the game's
+settings' environment variables (port/linux/README.md), for tests */
+static void environment_file(struct environment *environment)
+{
+	FILE *file = fopen(HOST_DATA_ROOT "/environment.txt", "r");
+	char line[512];
+
+	if (!file)
+		return;
+	while (fgets(line, sizeof(line), file))
+	{
+		char *equals = strchr(line, '=');
+		size_t length = strlen(line);
+
+		while (length && (line[length - 1] == '\n' || line[length - 1] == '\r'))
+			line[--length] = 0;
+		if (!equals || line[0] == '#')
+			continue;
+		*equals = 0;
+		environment_set(environment, line, equals + 1);
+		host_logf(HOST_LOG_INFO, "environment.txt: %s=%s", line, equals + 1);
+	}
+	fclose(file);
+}
+
+/* env.txt in the data folder: NAME=value lines for the host itself, before
+anything reads them: Mesa's switches (GALLIUM_THREAD=0, mesa_glthread=false,
+ZINK_DEBUG=...), for tests without a new package */
+static void host_environment_file(void)
+{
+	FILE *file = fopen(HOST_DATA_ROOT "/env.txt", "r");
+	char line[512];
+
+	if (!file)
+		return;
+	while (fgets(line, sizeof(line), file))
+	{
+		char *equals = strchr(line, '=');
+		size_t length = strlen(line);
+
+		while (length && (line[length - 1] == '\n' || line[length - 1] == '\r'))
+			line[--length] = 0;
+		if (!equals || line[0] == '#')
+			continue;
+		*equals = 0;
+		setenv(line, equals + 1, 1);
+		host_logf(HOST_LOG_INFO, "env.txt: %s=%s", line, equals + 1);
+	}
+	fclose(file);
+}
+
+/* copies argv and the environment into guest memory */
+static uint32_t make_boot(const struct environment *environment)
+{
+	size_t size = 0x10000;
+	char *memory = host_low_map(size, 3);
+	struct halo_guest_boot *boot = (struct halo_guest_boot *)memory;
+	uint32_t *argv = (uint32_t *)(memory + sizeof(*boot));
+	uint32_t *environ_list = argv + 2;
+	char *strings = (char *)(environ_list + ENVIRONMENT_MAXIMUM + 1);
+	int index;
+
+	if (!memory)
+		host_fatal("cannot allocate the guest's environment");
+	strcpy(strings, HOST_DATA_ROOT "/halo");
+	argv[0] = (uint32_t)(uintptr_t)strings;
+	argv[1] = 0;
+	strings += strlen(strings) + 1;
+	for (index = 0; index < environment->count; index++)
+	{
+		size_t length = strlen(environment->entries[index]) + 1;
+
+		if (strings + length > memory + size)
+			break;
+		memcpy(strings, environment->entries[index], length);
+		environ_list[index] = (uint32_t)(uintptr_t)strings;
+		strings += length;
+	}
+	environ_list[index] = 0;
+	boot->argc = 1;
+	boot->argv = (uint32_t)(uintptr_t)argv;
+	boot->environment = (uint32_t)(uintptr_t)environ_list;
+	/* the PS4's pages, which musl's allocator then rounds its mappings to */
+	boot->page_size = 0x4000;
+	return (uint32_t)(uintptr_t)boot;
+}
+
+static void *read_file(const char *path, size_t *size)
+{
+	int fd = open(path, O_RDONLY);
+	struct stat information;
+	char *data;
+	size_t done = 0;
+
+	if (fd < 0)
+		return NULL;
+	if (fstat(fd, &information) != 0 || information.st_size <= 0)
+	{
+		close(fd);
+		return NULL;
+	}
+	data = malloc((size_t)information.st_size);
+	while (data && done < (size_t)information.st_size)
+	{
+		ssize_t got = read(fd, data + done, (size_t)information.st_size - done);
+
+		if (got <= 0)
+		{
+			free(data);
+			data = NULL;
+			break;
+		}
+		done += (size_t)got;
+	}
+	close(fd);
+	*size = done;
+	return data;
+}
+
+/* copies a file of the package beside the data (the internet play's
+brokers) */
+static void copy_file(const char *from, const char *to)
+{
+	size_t size = 0;
+	void *data = read_file(from, &size);
+	int fd;
+
+	if (!data)
+		return;
+	fd = open(to, O_WRONLY | O_CREAT | O_TRUNC, 0666);
+	if (fd >= 0)
+	{
+		write(fd, data, size);
+		close(fd);
+	}
+	free(data);
+}
+
+/* POSIX TZ for the console's offset (the guest's musl has no zone database) */
+static void time_zone(char *buffer, size_t size)
+{
+	time_t now = time(NULL);
+	struct tm local, universal;
+	long offset;
+
+	localtime_r(&now, &local);
+	gmtime_r(&now, &universal);
+	offset = -(long)difftime(mktime(&local), mktime(&universal));
+	snprintf(buffer, size, "<L>%s%ld:%02ld", offset < 0 ? "-" : "", labs(offset) / 3600, (labs(offset) / 60) % 60);
+}
+
+/* ---------- main */
+
+#define MAIN_STACK_SIZE (16 * 1024 * 1024)
+
+static void *game_main(void *unused)
+{
+	struct environment environment = { { 0 }, 0 };
+	char zone[64];
+	size_t image_size = 0;
+	void *image;
+	struct stat information;
+
+	(void)unused;
+	mkdir(HOST_DATA_ROOT, 0777);
+	mkdir(HOST_SAVE_ROOT, 0777);
+	environment_set(&environment, "HOME", HOST_SAVE_ROOT);
+	environment_set(&environment, "HALO_DATA_ROOT", HOST_DATA_ROOT);
+	environment_set(&environment, "HALO_SAVE_ROOT", HOST_SAVE_ROOT);
+	/* 480 lines in the TV's 16:9 shape (d3d8_gl.c), as Android does for its
+	display */
+	environment_set(&environment, "HALO_DISPLAY_WIDTH", "854");
+	time_zone(zone, sizeof(zone));
+	environment_set(&environment, "TZ", zone);
+	environment_file(&environment);
+	copy_file(HOST_PACKAGE_ROOT "/brokers.txt", HOST_DATA_ROOT "/brokers.txt");
+	if (stat(HOST_PACKAGE_ROOT "/maps/ui.map", &information) != 0 && stat(HOST_DATA_ROOT "/maps/ui.map", &information) != 0)
+		host_logf(HOST_LOG_INFO, "no maps in the package or %s yet: a disc image (.iso) there is extracted", HOST_DATA_ROOT);
+
+	ps4_boot_trace("loading the game image");
+	image = read_file(HOST_PACKAGE_ROOT "/halo_guest.elf", &image_size);
+	if (!image)
+		host_fatal("cannot read the game image " HOST_PACKAGE_ROOT "/halo_guest.elf");
+	if (host_load_image(image, image_size) != 0)
+	{
+		host_memory_report_low_mappings();
+		host_fatal("cannot load the game image; see " HOST_DATA_ROOT "/opence.log");
+	}
+	free(image);
+	host_logf(HOST_LOG_INFO, "write tracking: page protection (16 KB pages)");
+	ps4_boot_trace("starting the game");
+	host_run_guest_main(make_boot(&environment));
+}
+
+int main(int argc, char *argv[])
+{
+	int fd;
+
+	(void)argc;
+	(void)argv;
+	/* The guest's standard output and error are the host's log
+	(host_syscall.c sends its descriptors 1 and 2 there): a file opened for
+	it must never be given those numbers, which a PS4 process need not have
+	open. */
+	mkdir(HOST_DATA_ROOT, 0777);
+	for (fd = 0; fd <= 2; fd++)
+	{
+		if (fcntl(fd, F_GETFD) == -1)
+			open(HOST_DATA_ROOT "/stdio.log", O_WRONLY | O_CREAT | O_APPEND, 0666);
+	}
+	host_logf(HOST_LOG_INFO, "OpenCE for PS4 starting");
+	ps4_boot_trace("OpenCE " OPENCE_PS4_VERSION " starting");
+	host_environment_file();
+	if (host_memory_initialize() != 0)
+	{
+		host_memory_report_low_mappings();
+		host_fatal("cannot reserve the game's memory below 4 GB; see " HOST_DATA_ROOT "/opence.log");
+	}
+	host_install_signal_handlers();
+	if (host_native_thread_create(game_main, NULL, MAIN_STACK_SIZE, "game") != 0)
+		host_fatal("cannot start the game thread");
+	/* the game ends the process itself (host_exit) */
+	for (;;)
+		ps4_usleep(1000000);
+}
diff --git a/port/ps4/host/host_memory.c b/port/ps4/host/host_memory.c
new file mode 100644
index 00000000..b6eb66cb
--- /dev/null
+++ b/port/ps4/host/host_memory.c
@@ -0,0 +1,799 @@
+/*
+HOST_MEMORY.C
+
+Guest address space for the PS4 port.
+
+Everything the guest touches lies below 4 GB. On the PS4 that range holds
+only the eboot (at 0x400000); the kernel library and the host's heap live
+far above it. At start-up the host takes:
+
+- the Xbox contiguous window at 0x80000000 (128 MB), mapped whole;
+- the guest image's range right above it, mapped when the image loads,
+  readable, writable and executable (system flexible memory, the only
+  memory the PS4 lets an app run code from: the SSBU port's finding);
+- the rest of the space below 4 GB as pools, reserved address space whose
+  64 KB chunks are mapped with direct memory as they are handed out (to the
+  guest's malloc arenas, thread stacks and anonymous mappings). The PS4 has
+  no demand-zero memory to speak of: its anonymous (flexible) memory is a few
+  hundred MB, committed when mapped; an app has ~4.5 GB of direct memory.
+
+This file also implements guest memory write tracking (the interface of
+port/linux/src/memory_watch.c): the renderer write-protects the pages behind
+the textures it caches, and the fault handler here records the first write
+to each. The PS4 protects memory in 16 KB pages, so a watched page is 16 KB
+here (4 KB on Linux and Android): a write anywhere in it counts for all of
+it. A system call cannot fault on the guest's behalf (it fails with EFAULT),
+so the host makes pages writable before it reads into them
+(host_memory_prepare_write).
+*/
+
+#include "host.h"
+#include "host_watch_hash.h"
+
+#include <errno.h>
+#include <pthread.h>
+#include <sched.h>
+#include <signal.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/mman.h>
+#include <ucontext.h>
+#include <unistd.h>
+
+/* libkernel, declared by hand (as the SSBU port's runtime/ps4/memory.c:
+several OpenOrbis prototypes are wrong or take no parameters) */
+int32_t ps4_reserve_range(void **address, size_t size, int32_t flags, size_t alignment) __asm__("sceKernelReserveVirtualRange");
+int32_t ps4_map_direct(void **address, size_t size, int32_t protection, int32_t flags, off_t physical, size_t alignment) __asm__("sceKernelMapDirectMemory");
+int32_t ps4_allocate_direct(off_t start, off_t end, size_t size, size_t alignment, int32_t type, off_t *physical) __asm__("sceKernelAllocateDirectMemory");
+size_t ps4_direct_memory_size(void) __asm__("sceKernelGetDirectMemorySize");
+int32_t ps4_available_direct(off_t start, off_t end, size_t alignment, off_t *physical, size_t *size) __asm__("sceKernelAvailableDirectMemorySize");
+int32_t ps4_munmap(void *address, size_t size) __asm__("sceKernelMunmap");
+int32_t ps4_mprotect(const void *address, size_t size, int32_t protection) __asm__("sceKernelMprotect");
+int32_t ps4_map_system_flexible(void **address, size_t size, int32_t protection, int32_t flags, const char *name) __asm__("sceKernelMapNamedSystemFlexibleMemory");
+int32_t ps4_map_flexible(void **address, size_t size, int32_t protection, int32_t flags, const char *name) __asm__("sceKernelMapNamedFlexibleMemory");
+
+#define PS4_MAP_FIXED 0x10
+#define PS4_WB_ONION 0
+#define PROT_RW (PROT_READ | PROT_WRITE)
+#define PROT_RWX (PROT_READ | PROT_WRITE | PROT_EXEC)
+
+/* the guest's Linux mmap flags (port/ps4/guest/libc/arch/x32_guest) */
+#define GUEST_MAP_FIXED 0x10
+#define GUEST_MAP_ANONYMOUS 0x20
+#define GUEST_MAP_FIXED_NOREPLACE 0x100000
+#define GUEST_EINVAL 22
+#define GUEST_ENOMEM 12
+#define GUEST_EFAULT 14
+
+#define LOW_LIMIT 0x100000000ULL
+#define HOST_PAGE 0x4000ULL           /* what is protected */
+#define CHUNK 0x10000ULL              /* what is mapped */
+#define CHUNK_COUNT (LOW_LIMIT / CHUNK)
+#define BLOCK (32ULL << 20)           /* what direct memory is allocated in */
+#define MAXIMUM_FREE_CHUNKS 65536
+
+/* the pools, in the order they are drawn from: above the image first (the
+Custom Edition tag cache wants 0x40440000, Xbox build pointers) */
+static const struct { uint64_t base, end; } pool_ranges[] =
+{
+	{ 0x8c000000ULL, 0xff000000ULL },
+	{ 0x42000000ULL, 0x80000000ULL },
+	{ 0x20000000ULL, 0x42000000ULL },
+};
+#define POOL_RANGE_COUNT (sizeof(pool_ranges) / sizeof(pool_ranges[0]))
+
+/* each 64 KB chunk below 4 GB: none of ours, reserved and free, or handed
+out (then backed by direct memory, its offset / CHUNK + 1 in chunk_physical) */
+enum { _chunk_none, _chunk_free, _chunk_used };
+static uint8_t chunk_state[CHUNK_COUNT];
+static uint32_t chunk_physical[CHUNK_COUNT];
+static int pool_reserved[POOL_RANGE_COUNT];
+static pthread_mutex_t memory_lock = PTHREAD_MUTEX_INITIALIZER;
+
+static uint64_t window_base, window_end;
+static uint64_t image_base, image_end;
+
+/* direct memory, handed out by chunk from blocks */
+static uint64_t block_at, block_size, block_used;
+static uint32_t free_physical[MAXIMUM_FREE_CHUNKS];
+static uint32_t free_physical_count;
+static uint64_t mapped_bytes;
+
+static uint64_t round_up(uint64_t value, uint64_t to)
+{
+	return (value + to - 1) & ~(to - 1);
+}
+
+static int in_range(uint64_t address, uint64_t size, uint64_t base, uint64_t end)
+{
+	return address >= base && address + size <= end && address + size >= address;
+}
+
+uint64_t host_direct_memory_free(void)
+{
+	off_t start = 0;
+	size_t size = 0;
+
+	if (ps4_available_direct(0, (off_t)ps4_direct_memory_size(), CHUNK, &start, &size) != 0)
+		return 0;
+	return size;
+}
+
+/* ---------- direct memory */
+
+#define NO_PHYSICAL 0xffffffffu
+
+static uint32_t physical_take(void)
+{
+	if (free_physical_count)
+		return free_physical[--free_physical_count];
+	if (block_used == block_size)
+	{
+		off_t physical = 0;
+		uint64_t size = BLOCK;
+
+		while (ps4_allocate_direct(0, (off_t)ps4_direct_memory_size(), size, CHUNK, PS4_WB_ONION, &physical) != 0)
+		{
+			size /= 2;
+			if (size < CHUNK)
+				return NO_PHYSICAL;
+		}
+		block_at = (uint64_t)physical;
+		block_size = size;
+		block_used = 0;
+	}
+	block_used += CHUNK;
+	return (uint32_t)((block_at + block_used - CHUNK) / CHUNK);
+}
+
+static void physical_give(uint32_t physical)
+{
+	if (free_physical_count < MAXIMUM_FREE_CHUNKS)
+		free_physical[free_physical_count++] = physical;
+}
+
+static void reserve_back(uint64_t address, uint64_t size)
+{
+	void *at = (void *)(uintptr_t)address;
+
+	ps4_reserve_range(&at, size, PS4_MAP_FIXED, 0);
+}
+
+/* backs chunk index with zeroed direct memory (under memory_lock) */
+static int chunk_map(uint64_t index, int protection)
+{
+	uint64_t address = index * CHUNK;
+	uint32_t physical = physical_take();
+	void *at = (void *)(uintptr_t)address;
+
+	if (physical == NO_PHYSICAL)
+		return -1;
+	/* (mapping over our own reservation fails) */
+	ps4_munmap(at, CHUNK);
+	if (ps4_map_direct(&at, CHUNK, PROT_RW, PS4_MAP_FIXED, (off_t)physical * (off_t)CHUNK, CHUNK) != 0 ||
+		at != (void *)(uintptr_t)address)
+	{
+		reserve_back(address, CHUNK);
+		physical_give(physical);
+		return -1;
+	}
+	/* direct memory comes with whatever was there before */
+	memset(at, 0, CHUNK);
+	if (protection != PROT_RW)
+		ps4_mprotect(at, CHUNK, protection);
+	chunk_physical[index] = physical + 1;
+	chunk_state[index] = _chunk_used;
+	mapped_bytes += CHUNK;
+	return 0;
+}
+
+static void chunk_unmap(uint64_t index)
+{
+	uint64_t address = index * CHUNK;
+
+	if (chunk_physical[index])
+	{
+		ps4_munmap((void *)(uintptr_t)address, CHUNK);
+		reserve_back(address, CHUNK);
+		physical_give(chunk_physical[index] - 1);
+		chunk_physical[index] = 0;
+		mapped_bytes -= CHUNK;
+	}
+	chunk_state[index] = _chunk_free;
+}
+
+/* ---------- the fixed ranges and the pools */
+
+int host_memory_initialize(void)
+{
+	off_t physical = 0;
+	void *at;
+	unsigned index;
+	int result;
+
+	/* the Xbox window, whole */
+	at = (void *)(uintptr_t)HALO_GUEST_WINDOW_BASE;
+	result = ps4_allocate_direct(0, (off_t)ps4_direct_memory_size(), HALO_GUEST_WINDOW_SIZE, 2 << 20, PS4_WB_ONION,
+		&physical);
+	if (result != 0)
+	{
+		host_logf(HOST_LOG_ERROR, "no direct memory for the Xbox window (%#x)", (unsigned)result);
+		return -1;
+	}
+	result = ps4_map_direct(&at, HALO_GUEST_WINDOW_SIZE, PROT_RW, PS4_MAP_FIXED, physical, 2 << 20);
+	if (result != 0 || at != (void *)(uintptr_t)HALO_GUEST_WINDOW_BASE)
+	{
+		host_logf(HOST_LOG_ERROR, "cannot map the Xbox window at %08x (%#x, got %p)", HALO_GUEST_WINDOW_BASE,
+			(unsigned)result, at);
+		return -1;
+	}
+	memset(at, 0, HALO_GUEST_WINDOW_SIZE);
+	window_base = HALO_GUEST_WINDOW_BASE;
+	window_end = window_base + HALO_GUEST_WINDOW_SIZE;
+
+	/* the image's range, address space only until the image loads */
+	at = (void *)(uintptr_t)HALO_GUEST_IMAGE_BASE;
+	result = ps4_reserve_range(&at, HALO_GUEST_IMAGE_RESERVE, PS4_MAP_FIXED, 0);
+	if (result != 0 || at != (void *)(uintptr_t)HALO_GUEST_IMAGE_BASE)
+	{
+		host_logf(HOST_LOG_ERROR, "cannot reserve the guest image range at %08x (%#x)", HALO_GUEST_IMAGE_BASE,
+			(unsigned)result);
+		return -1;
+	}
+
+	/* the pools */
+	for (index = 0; index < POOL_RANGE_COUNT; index++)
+	{
+		uint64_t base = pool_ranges[index].base, end = pool_ranges[index].end, chunk;
+
+		at = (void *)(uintptr_t)base;
+		result = ps4_reserve_range(&at, end - base, PS4_MAP_FIXED, 0);
+		if (result != 0 || at != (void *)(uintptr_t)base)
+		{
+			host_logf(HOST_LOG_WARN, "guest pool %08llx-%08llx not reserved (%#x, got %p)",
+				(unsigned long long)base, (unsigned long long)end, (unsigned)result, at);
+			continue;
+		}
+		pool_reserved[index] = 1;
+		for (chunk = base / CHUNK; chunk < end / CHUNK; chunk++)
+			chunk_state[chunk] = _chunk_free;
+		host_logf(HOST_LOG_INFO, "guest pool %08llx-%08llx (%llu MB)", (unsigned long long)base,
+			(unsigned long long)end, (unsigned long long)((end - base) >> 20));
+	}
+	host_logf(HOST_LOG_INFO, "Xbox window %08x-%08x, image range %08x-%08x; direct memory free %llu MB",
+		HALO_GUEST_WINDOW_BASE, HALO_GUEST_WINDOW_BASE + HALO_GUEST_WINDOW_SIZE, HALO_GUEST_IMAGE_BASE,
+		HALO_GUEST_IMAGE_BASE + HALO_GUEST_IMAGE_RESERVE, (unsigned long long)(host_direct_memory_free() >> 20));
+	return 0;
+}
+
+/* the code (and the read-only data after it) in executable flexible memory,
+the writable data and bss in direct memory chunks */
+int host_memory_map_image(uint32_t base, uint32_t code_size, uint32_t size)
+{
+	uint64_t code_length = round_up(code_size, CHUNK), length = round_up(size, CHUNK), chunk;
+	void *at = (void *)(uintptr_t)base;
+	int result;
+
+	if (base != HALO_GUEST_IMAGE_BASE || length > HALO_GUEST_IMAGE_RESERVE || code_length > length)
+	{
+		host_logf(HOST_LOG_ERROR, "the guest image (%08x, %u bytes) does not fit its range", base, size);
+		return -1;
+	}
+	ps4_munmap(at, code_length);
+	result = ps4_map_system_flexible(&at, code_length, PROT_RWX, PS4_MAP_FIXED, "opence guest code");
+	if (result != 0 || at != (void *)(uintptr_t)base)
+	{
+		host_logf(HOST_LOG_WARN, "guest image: no executable system flexible memory (%#x), trying flexible memory",
+			(unsigned)result);
+		at = (void *)(uintptr_t)base;
+		result = ps4_map_flexible(&at, code_length, PROT_RWX, PS4_MAP_FIXED, "opence guest code");
+	}
+	if (result != 0 || at != (void *)(uintptr_t)base)
+	{
+		host_logf(HOST_LOG_ERROR, "cannot map the guest code at %08x (%#x, got %p)", base, (unsigned)result, at);
+		reserve_back(base, code_length);
+		return -1;
+	}
+	memset(at, 0, code_length);
+	pthread_mutex_lock(&memory_lock);
+	for (chunk = (base + code_length) / CHUNK; chunk < (base + length) / CHUNK; chunk++)
+	{
+		chunk_state[chunk] = _chunk_free;
+		if (chunk_map(chunk, PROT_RW) != 0)
+		{
+			pthread_mutex_unlock(&memory_lock);
+			host_logf(HOST_LOG_ERROR, "no direct memory for the guest image's data");
+			return -1;
+		}
+	}
+	pthread_mutex_unlock(&memory_lock);
+	image_base = base;
+	image_end = base + length;
+	host_logf(HOST_LOG_INFO, "guest image: %llu KB of code at %08x, %llu KB of data", (unsigned long long)(code_length >> 10),
+		base, (unsigned long long)((length - code_length) >> 10));
+	return 0;
+}
+
+void host_memory_report_low_mappings(void)
+{
+	unsigned index;
+
+	host_logf(HOST_LOG_INFO, "below 4 GB: window %08llx-%08llx, image %08llx-%08llx, %llu MB of pool chunks mapped",
+		(unsigned long long)window_base, (unsigned long long)window_end, (unsigned long long)image_base,
+		(unsigned long long)image_end, (unsigned long long)(mapped_bytes >> 20));
+	for (index = 0; index < POOL_RANGE_COUNT; index++)
+		host_logf(HOST_LOG_INFO, "  pool %08llx-%08llx %s", (unsigned long long)pool_ranges[index].base,
+			(unsigned long long)pool_ranges[index].end, pool_reserved[index] ? "reserved" : "unavailable");
+}
+
+/* ---------- pools */
+
+/* the first run of count free chunks, in pool order; 0 if none */
+static uint64_t chunks_find(uint64_t count)
+{
+	unsigned range;
+
+	for (range = 0; range < POOL_RANGE_COUNT; range++)
+	{
+		uint64_t first = pool_ranges[range].base / CHUNK, end = pool_ranges[range].end / CHUNK, chunk, run = 0;
+
+		if (!pool_reserved[range])
+			continue;
+		for (chunk = first; chunk < end; chunk++)
+		{
+			if (chunk_state[chunk] != _chunk_free)
+			{
+				run = 0;
+				continue;
+			}
+			if (++run == count)
+				return chunk + 1 - count;
+		}
+	}
+	return 0;
+}
+
+static int chunks_map(uint64_t first, uint64_t count, int protection)
+{
+	uint64_t chunk;
+
+	for (chunk = first; chunk < first + count; chunk++)
+	{
+		if (chunk_map(chunk, protection) != 0)
+		{
+			while (chunk > first)
+				chunk_unmap(--chunk);
+			return -1;
+		}
+	}
+	return 0;
+}
+
+void *host_low_map(size_t size, int protection)
+{
+	uint64_t count = round_up(size, CHUNK) / CHUNK, first;
+	void *result = NULL;
+
+	if (!count)
+		return NULL;
+	/* (PROT_NONE reservations are backed too: the PS4 cannot fault pages in
+	later, and the guest makes them accessible with mprotect) */
+	if (protection == PROT_NONE)
+		protection = PROT_RW;
+	pthread_mutex_lock(&memory_lock);
+	first = chunks_find(count);
+	if (first && chunks_map(first, count, protection) == 0)
+		result = (void *)(uintptr_t)(first * CHUNK);
+	pthread_mutex_unlock(&memory_lock);
+	if (!result)
+		host_logf(HOST_LOG_ERROR, "guest memory: %llu KB could not be mapped (%llu MB mapped, %llu MB direct free)",
+			(unsigned long long)(count * CHUNK >> 10), (unsigned long long)(mapped_bytes >> 20),
+			(unsigned long long)(host_direct_memory_free() >> 20));
+	return result;
+}
+
+void host_low_unmap(void *address, size_t size)
+{
+	uint64_t first = (uint64_t)(uintptr_t)address / CHUNK;
+	uint64_t end = round_up((uint64_t)(uintptr_t)address + size, CHUNK) / CHUNK, chunk;
+
+	if (end > CHUNK_COUNT)
+		return;
+	pthread_mutex_lock(&memory_lock);
+	for (chunk = first; chunk < end; chunk++)
+	{
+		if (chunk_state[chunk] == _chunk_used)
+			chunk_unmap(chunk);
+	}
+	pthread_mutex_unlock(&memory_lock);
+}
+
+int host_low_owns(uintptr_t address, size_t size)
+{
+	uint64_t chunk, end;
+
+	if (in_range(address, size, window_base, window_end) || in_range(address, size, image_base, image_end))
+		return 1;
+	if ((uint64_t)address + size > LOW_LIMIT || !size)
+		return 0;
+	end = round_up((uint64_t)address + size, CHUNK) / CHUNK;
+	for (chunk = address / CHUNK; chunk < end; chunk++)
+	{
+		if (chunk_state[chunk] != _chunk_used)
+			return 0;
+	}
+	return 1;
+}
+
+/* ---------- the guest's memory system calls */
+
+/* makes [address, address + length) of the pools fresh zeroed memory, mapped
+where it was not; -errno on failure */
+static long pool_replace(uint64_t address, uint64_t length, int protection, int replace)
+{
+	uint64_t first = address / CHUNK, end = round_up(address + length, CHUNK) / CHUNK, chunk;
+	long result = 0;
+
+	if (protection == PROT_NONE)
+		protection = PROT_RW;
+	pthread_mutex_lock(&memory_lock);
+	for (chunk = first; chunk < end; chunk++)
+	{
+		if (chunk_state[chunk] == _chunk_none || (chunk_state[chunk] == _chunk_used && !replace))
+		{
+			result = -GUEST_EINVAL;
+			break;
+		}
+	}
+	for (chunk = first; chunk < end && !result; chunk++)
+	{
+		if (chunk_state[chunk] == _chunk_free && chunk_map(chunk, protection) != 0)
+			result = -GUEST_ENOMEM;
+	}
+	pthread_mutex_unlock(&memory_lock);
+	if (!result)
+	{
+		ps4_mprotect((void *)(uintptr_t)(address & ~(HOST_PAGE - 1)), round_up(address + length, HOST_PAGE) -
+			(address & ~(HOST_PAGE - 1)), PROT_RW);
+		memset((void *)(uintptr_t)address, 0, length);
+		if (protection != PROT_RW)
+			ps4_mprotect((void *)(uintptr_t)address, length, protection);
+	}
+	return result;
+}
+
+static void window_written(uint64_t address, uint64_t size);
+
+long host_guest_mmap(uint64_t address, uint64_t size, int protection, int flags, int fd, int64_t offset)
+{
+	uint64_t length = round_up(size, HOST_PAGE);
+	long result;
+
+	if (!length)
+		return -GUEST_EINVAL;
+	protection &= PROT_RWX;
+	if (flags & (GUEST_MAP_FIXED | GUEST_MAP_FIXED_NOREPLACE))
+	{
+		if (address + length > LOW_LIMIT)
+			return -GUEST_ENOMEM;
+		if (in_range(address, length, window_base, window_end))
+		{
+			/* the window stays mapped and writable (16 KB host pages hold four
+			of the guest's): a fresh block is zeroed, a freed one left as it is */
+			window_written(address, size);
+			if (protection != PROT_NONE)
+				memset((void *)(uintptr_t)address, 0, size);
+			result = (long)address;
+		}
+		else if (in_range(address, length, image_base, image_end))
+		{
+			return -GUEST_EINVAL;
+		}
+		else
+		{
+			result = pool_replace(address, length, protection, !(flags & GUEST_MAP_FIXED_NOREPLACE));
+			if (result == 0)
+				result = (long)address;
+		}
+	}
+	else
+	{
+		void *mapped = host_low_map(length, protection);
+
+		if (!mapped)
+			return -GUEST_ENOMEM;
+		result = (long)(uintptr_t)mapped;
+	}
+	/* a file mapping: a private copy of the file's bytes */
+	if (result > 0 && !(flags & GUEST_MAP_ANONYMOUS) && fd >= 0)
+	{
+		uint64_t done = 0;
+
+		ps4_mprotect((void *)(uintptr_t)(result & ~(HOST_PAGE - 1)), round_up((uint64_t)result + length, HOST_PAGE) -
+			((uint64_t)result & ~(HOST_PAGE - 1)), PROT_RW);
+		while (done < size)
+		{
+			ssize_t got = pread(fd, (char *)(uintptr_t)result + done, size - done, offset + (off_t)done);
+
+			if (got <= 0)
+				break;
+			done += (uint64_t)got;
+		}
+		if (protection != PROT_RW && protection != PROT_NONE)
+			ps4_mprotect((void *)(uintptr_t)result, length, protection);
+	}
+	return result;
+}
+
+long host_guest_munmap(uint64_t address, uint64_t size)
+{
+	uint64_t length = round_up(size, HOST_PAGE);
+
+	if (address + length > LOW_LIMIT)
+		return -GUEST_EINVAL;
+	if (in_range(address, length, window_base, window_end))
+	{
+		window_written(address, size);
+		return 0;
+	}
+	if (in_range(address, length, image_base, image_end))
+		return -GUEST_EINVAL;
+	host_low_unmap((void *)(uintptr_t)address, length);
+	return 0;
+}
+
+long host_guest_mprotect(uint64_t address, uint64_t size, int protection)
+{
+	uint64_t start = address & ~(HOST_PAGE - 1), end = round_up(address + size, HOST_PAGE);
+
+	if (end > LOW_LIMIT)
+		return -GUEST_EINVAL;
+	/* the window's protection belongs to the write tracking: the guest's
+	4 KB pages share the PS4's 16 KB ones */
+	if (in_range(address, size, window_base, window_end))
+		return 0;
+	if (!host_low_owns(start, end - start))
+		return -GUEST_ENOMEM;
+	if (protection == PROT_NONE && (address & (HOST_PAGE - 1) || size & (HOST_PAGE - 1)))
+		return 0;
+	return ps4_mprotect((void *)(uintptr_t)start, end - start, protection & PROT_RWX) ? -GUEST_EINVAL : 0;
+}
+
+/* ---------- write tracking (port/linux/src/memory_watch.c) */
+
+#define WATCH_PAGE HOST_PAGE
+#define WATCH_PAGE_COUNT (HALO_GUEST_WINDOW_SIZE / WATCH_PAGE)
+
+/* (each page: 0 not watched, 1 watched and read-only, 2 made writable by a
+watched write; as Android's host_memory.c) */
+static uint8_t page_protected[WATCH_PAGE_COUNT];
+static uint32_t page_generation[WATCH_PAGE_COUNT];
+static volatile uint32_t current_generation = 1;
+static int watch_active;
+static int watch_hashing;
+static uint8_t page_hash_watched[HALO_GUEST_WINDOW_SIZE / WATCH_HASH_PAGE_SIZE];
+static uint64_t page_hash[HALO_GUEST_WINDOW_SIZE / WATCH_HASH_PAGE_SIZE];
+static uint32_t page_hashed_frame[HALO_GUEST_WINDOW_SIZE / WATCH_HASH_PAGE_SIZE];
+static uint32_t page_hash_generation[HALO_GUEST_WINDOW_SIZE / WATCH_HASH_PAGE_SIZE];
+static struct watch_hash page_hashes =
+{
+	.base = (const uint8_t *)(uintptr_t)HALO_GUEST_WINDOW_BASE,
+	.page_count = HALO_GUEST_WINDOW_SIZE / WATCH_HASH_PAGE_SIZE,
+	.watched = page_hash_watched,
+	.hash = page_hash,
+	.hashed_frame = page_hashed_frame,
+	.generation = page_hash_generation,
+	.current_generation = &current_generation,
+	.frame = 1,
+};
+
+static int in_window(uint64_t address)
+{
+	return address >= HALO_GUEST_WINDOW_BASE && address - HALO_GUEST_WINDOW_BASE < HALO_GUEST_WINDOW_SIZE;
+}
+
+static uint64_t watch_page(uint64_t address)
+{
+	return (address - HALO_GUEST_WINDOW_BASE) / WATCH_PAGE;
+}
+
+static void mark_written(uint64_t page)
+{
+	page_generation[page] = __sync_add_and_fetch(&current_generation, 1);
+	page_protected[page] = 2;
+	ps4_mprotect((void *)(uintptr_t)(HALO_GUEST_WINDOW_BASE + page * WATCH_PAGE), WATCH_PAGE, PROT_RW);
+}
+
+/* [first, last] of the watch pages of a range clipped to the window; 0 if
+none */
+static int watch_pages(uint64_t address, uint64_t size, uint64_t *first, uint64_t *last)
+{
+	uint64_t start = address, end = address + size;
+
+	if (!size || end <= HALO_GUEST_WINDOW_BASE || start >= (uint64_t)HALO_GUEST_WINDOW_BASE + HALO_GUEST_WINDOW_SIZE)
+		return 0;
+	if (start < HALO_GUEST_WINDOW_BASE)
+		start = HALO_GUEST_WINDOW_BASE;
+	if (end > (uint64_t)HALO_GUEST_WINDOW_BASE + HALO_GUEST_WINDOW_SIZE)
+		end = (uint64_t)HALO_GUEST_WINDOW_BASE + HALO_GUEST_WINDOW_SIZE;
+	*first = watch_page(start);
+	*last = watch_page(end - 1);
+	return 1;
+}
+
+/* a remapped or freed block of the window: treat its pages as written and
+unwatched */
+static void window_written(uint64_t address, uint64_t size)
+{
+	uint64_t first, last, page;
+
+	if (!watch_pages(address, size, &first, &last))
+		return;
+	if (watch_hashing)
+	{
+		watch_hash_forget(&page_hashes, (uint32_t)((address - HALO_GUEST_WINDOW_BASE) / WATCH_HASH_PAGE_SIZE),
+			(uint32_t)((address + size - 1 - HALO_GUEST_WINDOW_BASE) / WATCH_HASH_PAGE_SIZE));
+		return;
+	}
+	for (page = first; page <= last; page++)
+	{
+		if (page_protected[page] == 1)
+			ps4_mprotect((void *)(uintptr_t)(HALO_GUEST_WINDOW_BASE + page * WATCH_PAGE), WATCH_PAGE, PROT_RW);
+		page_protected[page] = 0;
+		page_generation[page] = __sync_add_and_fetch(&current_generation, 1);
+	}
+}
+
+void host_memory_prepare_write(uint64_t address, uint64_t size)
+{
+	uint64_t first, last, page;
+
+	if (!watch_active || watch_hashing || !watch_pages(address, size, &first, &last))
+		return;
+	for (page = first; page <= last; page++)
+	{
+		if (page_protected[page] == 1)
+			mark_written(page);
+	}
+}
+
+static struct sigaction previous_segv, previous_bus;
+
+static void chain(struct sigaction *previous, int signal_number, siginfo_t *information, void *context)
+{
+	sigaction(signal_number, previous, NULL);
+	if (previous->sa_flags & SA_SIGINFO)
+	{
+		if (previous->sa_sigaction)
+			previous->sa_sigaction(signal_number, information, context);
+	}
+	else if (previous->sa_handler != SIG_DFL && previous->sa_handler != SIG_IGN)
+	{
+		previous->sa_handler(signal_number);
+	}
+	/* returning re-executes the faulting instruction under the previous
+	(or default) handler */
+}
+
+void host_debug_report_fault(int signal_number, siginfo_t *information, void *context);
+
+/* a write to a watched page; nonzero if it was one */
+static int watch_fault(uint64_t address)
+{
+	if (watch_active && !watch_hashing && in_window(address))
+	{
+		uint64_t page = watch_page(address);
+
+		if (page_protected[page] == 1)
+		{
+			mark_written(page);
+			return 1;
+		}
+		/* made writable by another thread meanwhile: the write is made again */
+		if (page_protected[page] == 2)
+			return 1;
+	}
+	return 0;
+}
+
+static void segv_handler(int signal_number, siginfo_t *information, void *context)
+{
+	if (watch_fault((uint64_t)(uintptr_t)information->si_addr))
+		return;
+	host_debug_report_fault(signal_number, information, context);
+	chain(&previous_segv, signal_number, information, context);
+}
+
+static void bus_handler(int signal_number, siginfo_t *information, void *context)
+{
+	/* (the PS4 reports some protection faults as SIGBUS) */
+	if (watch_fault((uint64_t)(uintptr_t)information->si_addr))
+		return;
+	host_debug_report_fault(signal_number, information, context);
+	chain(&previous_bus, signal_number, information, context);
+}
+
+void host_install_signal_handlers(void)
+{
+	struct sigaction action;
+
+	memset(&action, 0, sizeof(action));
+	action.sa_flags = SA_SIGINFO | SA_NODEFER | SA_ONSTACK;
+	sigemptyset(&action.sa_mask);
+	action.sa_sigaction = segv_handler;
+	sigaction(SIGSEGV, &action, &previous_segv);
+	action.sa_sigaction = bus_handler;
+	sigaction(SIGBUS, &action, &previous_bus);
+}
+
+void host_memory_watch_initialize(void)
+{
+	watch_active = 1;
+}
+
+void host_memory_watch_use_hashes(void)
+{
+	watch_hashing = 1;
+}
+
+void host_memory_watch_protect(uint32_t address, uint32_t size)
+{
+	uint64_t first, last, page;
+
+	if (!watch_active || !watch_pages(address, size, &first, &last))
+		return;
+	if (watch_hashing)
+	{
+		watch_hash_protect(&page_hashes, (uint32_t)(((uint64_t)address - HALO_GUEST_WINDOW_BASE) / WATCH_HASH_PAGE_SIZE),
+			(uint32_t)(((uint64_t)address + size - 1 - HALO_GUEST_WINDOW_BASE) / WATCH_HASH_PAGE_SIZE));
+		return;
+	}
+	for (page = first; page <= last; page++)
+	{
+		if (page_protected[page] != 1)
+		{
+			page_protected[page] = 1;
+			ps4_mprotect((void *)(uintptr_t)(HALO_GUEST_WINDOW_BASE + page * WATCH_PAGE), WATCH_PAGE, PROT_READ);
+		}
+	}
+}
+
+uint32_t host_memory_watch_serial(void)
+{
+	return current_generation;
+}
+
+uint32_t host_memory_watch_generation(uint32_t address, uint32_t size)
+{
+	uint64_t first, last, page;
+	uint32_t newest = 0;
+
+	if (!watch_pages(address, size, &first, &last))
+		return 0;
+	if (watch_hashing)
+		return watch_hash_generation(&page_hashes,
+			(uint32_t)(((uint64_t)address - HALO_GUEST_WINDOW_BASE) / WATCH_HASH_PAGE_SIZE),
+			(uint32_t)(((uint64_t)address + size - 1 - HALO_GUEST_WINDOW_BASE) / WATCH_HASH_PAGE_SIZE));
+	for (page = first; page <= last; page++)
+	{
+		if (page_generation[page] > newest)
+			newest = page_generation[page];
+	}
+	return newest;
+}
+
+void host_memory_watch_prepare_write(uint32_t address, uint32_t size)
+{
+	host_memory_prepare_write(address, size);
+}
+
+void host_memory_watch_forget(uint32_t address, uint32_t size)
+{
+	window_written(address, size);
+}
+
+void host_memory_watch_begin_frame(void)
+{
+	if (watch_hashing)
+		watch_hash_begin_frame(&page_hashes);
+}
