+HOST_POSIX_COMPAT.H
+
+What the platform layer's posix_*.c files (compiled into the PS4 host, as
+into Android's) take from Linux and the PS4's C library lacks. Included
+before each of them by the eboot's build.
+*/
+
+#ifndef __HALO_PS4_HOST_POSIX_COMPAT_H
+#define __HALO_PS4_HOST_POSIX_COMPAT_H
+
+#include <sys/socket.h>
+
+/* (sockets are not inherited by anything on the PS4, and the only
+non-blocking one asked for at creation is Discord's, which a console has
+not) */
+#ifndef SOCK_CLOEXEC
+#define SOCK_CLOEXEC 0
+#endif
+#ifndef SOCK_NONBLOCK
+#define SOCK_NONBLOCK 0
+#endif
+
+#endif
diff --git a/port/ps4/host/host_sdl.c b/port/ps4/host/host_sdl.c
new file mode 100644
index 00000000..f996f9b8
--- /dev/null
+++ b/port/ps4/host/host_sdl.c
@@ -0,0 +1,724 @@
+/*
+HOST_SDL.C
+
+The SDL functions the guest imports (port/android/guest/runtime/guest_sdl.c),
+on the PS4's own services instead of SDL: VideoOut through Zink's
+swapchain (the window and its OpenGL ES context, frontends/ps4 in the PS4
+Mesa), the DualShock 4s through ScePad (one controller for each user signed
+in, up to four), and sound through sceAudioOut. Windows, contexts, gamepads
+and audio streams are small integer handles, as on Android; events are
+written in SDL3's layout, which both ABIs share for those without pointers.
+*/
+
+#include "host.h"
+
+#include <SDL3/SDL_audio.h>
+#include <SDL3/SDL_events.h>
+#include <SDL3/SDL_gamepad.h>
+#include <SDL3/SDL_messagebox.h>
+#include <SDL3/SDL_video.h>
+
+#include <orbis/AudioOut.h>
+#include <orbis/Pad.h>
+#include <orbis/UserService.h>
+
+#include <errno.h>
+#include <pthread.h>
+#include <stdlib.h>
+#include <string.h>
+#include <time.h>
+
+#include "ps4_gl.h"
+
+static char last_error[256];
+static pthread_mutex_t sdl_lock = PTHREAD_MUTEX_INITIALIZER;
+
+static void set_error(const char *text)
+{
+	snprintf(last_error, sizeof(last_error), "%s", text);
+}
+
+int host_sdl_init(uint32_t flags)
+{
+	(void)flags;
+	return 1;
+}
+
+int host_sdl_set_hint(const char *name, const char *value)
+{
+	(void)name;
+	(void)value;
+	return 1;
+}
+
+void host_sdl_get_error(char *buffer, uint32_t size)
+{
+	if (size)
+		snprintf(buffer, size, "%s", last_error);
+}
+
+static uint64_t milliseconds_now(void)
+{
+	struct timespec now;
+
+	clock_gettime(CLOCK_MONOTONIC, &now);
+	return (uint64_t)now.tv_sec * 1000 + (uint64_t)now.tv_nsec / 1000000;
+}
+
+static uint64_t start_milliseconds;
+
+long long host_sdl_ticks(void)
+{
+	if (!start_milliseconds)
+		start_milliseconds = milliseconds_now();
+	return (long long)(milliseconds_now() - start_milliseconds);
+}
+
+long long host_sdl_thread_id(void)
+{
+	return host_thread_id();
+}
+
+/* ---------- events */
+
+#define EVENT_QUEUE 64
+
+static SDL_Event event_queue[EVENT_QUEUE];
+static int event_head, event_count;
+
+static void push_event(const SDL_Event *event)
+{
+	pthread_mutex_lock(&sdl_lock);
+	if (event_count < EVENT_QUEUE)
+	{
+		event_queue[(event_head + event_count) % EVENT_QUEUE] = *event;
+		event_count++;
+	}
+	pthread_mutex_unlock(&sdl_lock);
+}
+
+static void pads_update(int force);
+
+int host_sdl_poll_event(void *event)
+{
+	int found = 0;
+
+	pads_update(0);
+	pthread_mutex_lock(&sdl_lock);
+	if (event_count)
+	{
+		memcpy(event, &event_queue[event_head], sizeof(SDL_Event));
+		event_head = (event_head + 1) % EVENT_QUEUE;
+		event_count--;
+		found = 1;
+	}
+	pthread_mutex_unlock(&sdl_lock);
+	return found;
+}
+
+/* ---------- the window and its OpenGL ES context */
+
+static int gl_major = 3, gl_minor = 0, gl_depth = 24, gl_stencil = 8, gl_debug;
+static struct ps4gl_window *gl_window;
+static struct ps4gl_context *gl_context;
+
+uint32_t host_sdl_create_window(const char *title, int width, int height, long long flags)
+{
+	host_logf(HOST_LOG_INFO, "window \"%s\" asked for %dx%d (flags %llx): the screen is %dx%d", title ? title : "",
+		width, height, (unsigned long long)flags, HOST_SCREEN_WIDTH, HOST_SCREEN_HEIGHT);
+	return 1;
+}
+
+void host_sdl_window_size_in_pixels(uint32_t window, int *width, int *height)
+{
+	(void)window;
+	*width = HOST_SCREEN_WIDTH;
+	*height = HOST_SCREEN_HEIGHT;
+}
+
+int host_sdl_set_relative_mouse(uint32_t window, int enabled)
+{
+	(void)window;
+	(void)enabled;
+	return 1;
+}
+
+int host_sdl_gl_set_attribute(int attribute, int value)
+{
+	switch (attribute)
+	{
+	case SDL_GL_CONTEXT_MAJOR_VERSION: gl_major = value; break;
+	case SDL_GL_CONTEXT_MINOR_VERSION: gl_minor = value; break;
+	case SDL_GL_DEPTH_SIZE: gl_depth = value; break;
+	case SDL_GL_STENCIL_SIZE: gl_stencil = value; break;
+	case SDL_GL_CONTEXT_FLAGS: gl_debug = (value & SDL_GL_CONTEXT_DEBUG_FLAG) != 0; break;
+	default: break;
+	}
+	return 1;
+}
+
+uint32_t host_sdl_gl_create_context(uint32_t window)
+{
+	(void)window;
+	if (gl_context)
+		return 1;
+	ps4_boot_trace("gl: Zink");
+	if (!ps4gl_initialize())
+	{
+		host_logf(HOST_LOG_ERROR, "OpenGL: %s", ps4gl_error());
+		set_error(ps4gl_error());
+		return 0;
+	}
+	if (!gl_window)
+		gl_window = ps4gl_create_window(HOST_SCREEN_WIDTH, HOST_SCREEN_HEIGHT, gl_depth, gl_stencil);
+	if (gl_window)
+		gl_context = ps4gl_create_context(gl_window, 1, gl_major, gl_minor, gl_debug);
+	if (!gl_context)
+	{
+		host_logf(HOST_LOG_ERROR, "OpenGL ES %d.%d context: %s", gl_major, gl_minor, ps4gl_error());
+		set_error(ps4gl_error());
+		return 0;
+	}
+	host_logf(HOST_LOG_INFO, "OpenGL ES context (asked for %d.%d, depth %d, stencil %d) on Zink", gl_major, gl_minor,
+		gl_depth, gl_stencil);
+	ps4_boot_trace("gl: context");
+	return 1;
+}
+
+int host_sdl_gl_make_current(uint32_t window, uint32_t context)
+{
+	(void)window;
+	if (!context)
+		return ps4gl_make_current(NULL) ? 1 : 0;
+	return gl_context && ps4gl_make_current(gl_context) ? 1 : 0;
+}
+
+int host_sdl_gl_set_swap_interval(int interval)
+{
+	ps4gl_set_swap_interval(gl_context, interval);
+	return 1;
+}
+
+static uint64_t swaps;
+static uint64_t last_swap_at;
+
+int host_sdl_gl_swap_window(uint32_t window)
+{
+	uint64_t now;
+
+	(void)window;
+	ps4gl_swap_buffers(gl_context);
+	if (++swaps == 1)
+		ps4_boot_trace("gl: first frame presented");
+	host_sdl_frame();
+	/* hitches: frames of 50 ms and more, with the shaders made in them */
+	now = milliseconds_now();
+	if (last_swap_at)
+	{
+		unsigned compiled, linked;
+
+		host_gl_frame_counts(&compiled, &linked);
+		if (now - last_swap_at >= 50)
+			host_logf(HOST_LOG_WARN, "hitch: frame %llu took %llu ms (%u shaders compiled, %u programs linked)",
+				(unsigned long long)swaps, (unsigned long long)(now - last_swap_at), compiled, linked);
+	}
+	last_swap_at = now;
+	return 1;
+}
+
+/* ---------- the clipboard, messages */
+
+static char clipboard[1024];
+
+int host_sdl_set_clipboard_text(const char *text)
+{
+	snprintf(clipboard, sizeof(clipboard), "%s", text ? text : "");
+	return 1;
+}
+
+void host_sdl_get_clipboard_text(char *buffer, uint32_t size)
+{
+	if (size)
+		snprintf(buffer, size, "%s", clipboard);
+}
+
+void host_sdl_scancode_name(int scancode, char *buffer, uint32_t size)
+{
+	(void)scancode;
+	if (size)
+		buffer[0] = 0;
+}
+
+int host_sdl_scancode_from_name(const char *name)
+{
+	(void)name;
+	return 0;
+}
+
+int host_sdl_show_toast(const char *message, int duration, int gravity, int x, int y)
+{
+	(void)duration;
+	(void)gravity;
+	(void)x;
+	(void)y;
+	host_logf(HOST_LOG_INFO, "notice: %s", message ? message : "");
+	return 1;
+}
+
+int host_sdl_show_simple_message_box(uint32_t flags, const char *title, const char *message)
+{
+	host_logf((flags & SDL_MESSAGEBOX_ERROR) ? HOST_LOG_ERROR : HOST_LOG_INFO, "message (%s): %s",
+		title ? title : "", message ? message : "");
+	ps4_boot_trace(message ? message : "message");
+	return 1;
+}
+
+/* (no dialog yet: the default button, the first if none is) */
+int host_sdl_show_message_box(uint32_t flags, const char *title, const char *message, int default_index,
+	const char *button0, const char *button1, const char *button2)
+{
+	int chosen = default_index >= 0 ? default_index : 0;
+	const char *buttons[3] = { button0, button1, button2 };
+
+	host_logf(HOST_LOG_INFO, "question (%s): %s -> %s", title ? title : "", message ? message : "",
+		buttons[chosen] ? buttons[chosen] : "?");
+	(void)flags;
+	return chosen;
+}
+
+/* ---------- gamepads: one DualShock 4 for each user signed in */
+
+#define PAD_COUNT 4
+
+struct pad
+{
+	int user;
+	int handle;
+	OrbisPadData state;
+	uint64_t read_at;
+	uint64_t rumble_until;
+};
+
+static struct pad pads[PAD_COUNT];
+static int pads_ready;
+static uint64_t pads_checked_at;
+
+static void pads_initialize(void)
+{
+	int index;
+
+	if (pads_ready)
+		return;
+	sceUserServiceInitialize(NULL);
+	scePadInit();
+	for (index = 0; index < PAD_COUNT; index++)
+	{
+		pads[index].user = -1;
+		pads[index].handle = -1;
+	}
+	pads_ready = 1;
+}
+
+static void pad_event(Uint32 type, int index)
+{
+	SDL_Event event;
+
+	memset(&event, 0, sizeof(event));
+	event.gdevice.type = type;
+	event.gdevice.timestamp = (Uint64)host_sdl_ticks() * 1000000ULL;
+	event.gdevice.which = (SDL_JoystickID)(index + 1);
+	push_event(&event);
+}
+
+/* opens the pads of users who signed in, closes those of users who left
+(once a second, or when forced) */
+static void pads_update(int force)
+{
+	OrbisUserServiceLoginUserIdList users;
+	uint64_t now = milliseconds_now();
+	int index, slot;
+
+	pthread_mutex_lock(&sdl_lock);
+	pads_initialize();
+	if (!force && now - pads_checked_at < 1000)
+	{
+		pthread_mutex_unlock(&sdl_lock);
+		return;
+	}
+	pads_checked_at = now;
+	pthread_mutex_unlock(&sdl_lock);
+	memset(&users, 0xff, sizeof(users));
+	if (sceUserServiceGetLoginUserIdList(&users) != 0)
+		return;
+	/* users gone */
+	for (slot = 0; slot < PAD_COUNT; slot++)
+	{
+		int present = 0;
+
+		if (pads[slot].user < 0)
+			continue;
+		for (index = 0; index < ORBIS_USER_SERVICE_MAX_LOGIN_USERS; index++)
+			present |= users.userId[index] == pads[slot].user;
+		if (!present)
+		{
+			host_logf(HOST_LOG_INFO, "gamepad %d: user %d signed out", slot + 1, pads[slot].user);
+			scePadClose(pads[slot].handle);
+			pads[slot].user = -1;
+			pads[slot].handle = -1;
+			pad_event(SDL_EVENT_GAMEPAD_REMOVED, slot);
+		}
+	}
+	/* users new */
+	for (index = 0; index < ORBIS_USER_SERVICE_MAX_LOGIN_USERS; index++)
+	{
+		int user = users.userId[index], known = 0, handle;
+
+		if (user < 0)
+			continue;
+		for (slot = 0; slot < PAD_COUNT; slot++)
+			known |= pads[slot].user == user;
+		if (known)
+			continue;
+		for (slot = 0; slot < PAD_COUNT && pads[slot].user >= 0; slot++)
+			;
+		if (slot == PAD_COUNT)
+			break;
+		handle = scePadOpen(user, ORBIS_PAD_PORT_TYPE_STANDARD, 0, NULL);
+		if (handle < 0)
+			handle = scePadGetHandle(user, ORBIS_PAD_PORT_TYPE_STANDARD, 0);
+		if (handle < 0)
+		{
+			host_logf(HOST_LOG_WARN, "gamepad for user %d: scePadOpen %#x", user, (unsigned)handle);
+			continue;
+		}
+		memset(&pads[slot], 0, sizeof(pads[slot]));
+		pads[slot].user = user;
+		pads[slot].handle = handle;
+		host_logf(HOST_LOG_INFO, "gamepad %d: user %d's DualShock 4", slot + 1, user);
+		pad_event(SDL_EVENT_GAMEPAD_ADDED, slot);
+	}
+}
+
+static struct pad *pad_of(uint32_t gamepad)
+{
+	if (gamepad < 1 || gamepad > PAD_COUNT || pads[gamepad - 1].handle < 0)
+		return NULL;
+	return &pads[gamepad - 1];
+}
+
+static const OrbisPadData *pad_state(struct pad *pad)
+{
+	uint64_t now = milliseconds_now();
+
+	if (now - pad->read_at >= 4)
+	{
+		if (scePadReadState(pad->handle, &pad->state) != 0)
+			memset(&pad->state, 0, sizeof(pad->state));
+		pad->read_at = now;
+	}
+	return &pad->state;
+}
+
+void host_sdl_frame(void)
+{
+	uint64_t now = milliseconds_now();
+	int slot;
+
+	for (slot = 0; slot < PAD_COUNT; slot++)
+	{
+		if (pads[slot].handle >= 0 && pads[slot].rumble_until && now >= pads[slot].rumble_until)
+		{
+			OrbisPadVibeParam off = { 0, 0 };
+
+			scePadSetVibration(pads[slot].handle, &off);
+			pads[slot].rumble_until = 0;
+		}
+	}
+}
+
+int host_sdl_get_gamepads(uint32_t *ids, int capacity)
+{
+	int found = 0, slot;
+
+	pads_update(0);
+	for (slot = 0; slot < PAD_COUNT && found < capacity; slot++)
+	{
+		if (pads[slot].handle >= 0)
+			ids[found++] = (uint32_t)(slot + 1);
+	}
+	return found;
+}
+
+uint32_t host_sdl_open_gamepad(uint32_t id)
+{
+	return pad_of(id) ? id : 0;
+}
+
+uint32_t host_sdl_gamepad_from_id(uint32_t id)
+{
+	return pad_of(id) ? id : 0;
+}
+
+/* 0..255 sticks (128 at rest) as SDL's -32768..32767, triggers as 0..32767 */
+static int stick_axis(uint8_t value)
+{
+	return (int)value * 65535 / 255 - 32768;
+}
+
+int host_sdl_gamepad_axis(uint32_t gamepad, int axis)
+{
+	struct pad *pad = pad_of(gamepad);
+	const OrbisPadData *state;
+
+	if (!pad)
+		return 0;
+	state = pad_state(pad);
+	switch (axis)
+	{
+	case SDL_GAMEPAD_AXIS_LEFTX: return stick_axis(state->leftStick.x);
+	case SDL_GAMEPAD_AXIS_LEFTY: return stick_axis(state->leftStick.y);
+	case SDL_GAMEPAD_AXIS_RIGHTX: return stick_axis(state->rightStick.x);
+	case SDL_GAMEPAD_AXIS_RIGHTY: return stick_axis(state->rightStick.y);
+	case SDL_GAMEPAD_AXIS_LEFT_TRIGGER: return (int)state->analogButtons.l2 * 32767 / 255;
+	case SDL_GAMEPAD_AXIS_RIGHT_TRIGGER: return (int)state->analogButtons.r2 * 32767 / 255;
+	default: return 0;
+	}
+}
+
+int host_sdl_gamepad_button(uint32_t gamepad, int button)
+{
+	struct pad *pad = pad_of(gamepad);
+	uint32_t buttons;
+
+	if (!pad)
+		return 0;
+	buttons = pad_state(pad)->buttons;
+	switch (button)
+	{
+	case SDL_GAMEPAD_BUTTON_SOUTH: return (buttons & ORBIS_PAD_BUTTON_CROSS) != 0;
+	case SDL_GAMEPAD_BUTTON_EAST: return (buttons & ORBIS_PAD_BUTTON_CIRCLE) != 0;
+	case SDL_GAMEPAD_BUTTON_WEST: return (buttons & ORBIS_PAD_BUTTON_SQUARE) != 0;
+	case SDL_GAMEPAD_BUTTON_NORTH: return (buttons & ORBIS_PAD_BUTTON_TRIANGLE) != 0;
+	/* the touchpad's click is the Xbox controller's back */
+	case SDL_GAMEPAD_BUTTON_BACK: return (buttons & ORBIS_PAD_BUTTON_TOUCH_PAD) != 0;
+	case SDL_GAMEPAD_BUTTON_START: return (buttons & ORBIS_PAD_BUTTON_OPTIONS) != 0;
+	case SDL_GAMEPAD_BUTTON_LEFT_STICK: return (buttons & ORBIS_PAD_BUTTON_L3) != 0;
+	case SDL_GAMEPAD_BUTTON_RIGHT_STICK: return (buttons & ORBIS_PAD_BUTTON_R3) != 0;
+	case SDL_GAMEPAD_BUTTON_LEFT_SHOULDER: return (buttons & ORBIS_PAD_BUTTON_L1) != 0;
+	case SDL_GAMEPAD_BUTTON_RIGHT_SHOULDER: return (buttons & ORBIS_PAD_BUTTON_R1) != 0;
+	case SDL_GAMEPAD_BUTTON_DPAD_UP: return (buttons & ORBIS_PAD_BUTTON_UP) != 0;
+	case SDL_GAMEPAD_BUTTON_DPAD_DOWN: return (buttons & ORBIS_PAD_BUTTON_DOWN) != 0;
+	case SDL_GAMEPAD_BUTTON_DPAD_LEFT: return (buttons & ORBIS_PAD_BUTTON_LEFT) != 0;
+	case SDL_GAMEPAD_BUTTON_DPAD_RIGHT: return (buttons & ORBIS_PAD_BUTTON_RIGHT) != 0;
+	case SDL_GAMEPAD_BUTTON_TOUCHPAD: return (buttons & ORBIS_PAD_BUTTON_TOUCH_PAD) != 0;
+	default: return 0;
+	}
+}
+
+int host_sdl_gamepad_type(uint32_t gamepad)
+{
+	return pad_of(gamepad) ? SDL_GAMEPAD_TYPE_PS4 : SDL_GAMEPAD_TYPE_UNKNOWN;
+}
+
+int host_sdl_rumble_gamepad(uint32_t gamepad, uint32_t low, uint32_t high, uint32_t milliseconds)
+{
+	struct pad *pad = pad_of(gamepad);
+	OrbisPadVibeParam vibration;
+
+	if (!pad)
+		return 0;
+	vibration.lgMotor = (uint8_t)(low >> 8);
+	vibration.smMotor = (uint8_t)(high >> 8);
+	scePadSetVibration(pad->handle, &vibration);
+	pad->rumble_until = (low || high) && milliseconds ? milliseconds_now() + milliseconds : 0;
+	return 1;
+}
+
+void host_sdl_close_gamepad(uint32_t gamepad)
+{
+	(void)gamepad;
+}
+
+/* ---------- audio: a stream feeds sceAudioOut from its own thread */
+
+#define AUDIO_GRAIN 256 /* frames a sceAudioOutOutput takes */
+#define AUDIO_BUFFER (64 * 1024)
+
+struct audio_stream
+{
+	int used;
+	uint32_t callback, userdata;
+	int channels;
+	int is_float;
+	int bytes_per_frame;
+	int running;
+	int closing;
+	int port;
+	uint8_t buffer[AUDIO_BUFFER];
+	uint32_t buffered;
+	pthread_mutex_t lock;
+};
+
+#define AUDIO_STREAMS 4
+
+static struct audio_stream audio_streams[AUDIO_STREAMS];
+
+static struct audio_stream *audio_of(uint32_t stream)
+{
+	if (stream < 1 || stream > AUDIO_STREAMS || !audio_streams[stream - 1].used)
+		return NULL;
+	return &audio_streams[stream - 1];
+}
+
+static void *audio_main(void *context)
+{
+	struct audio_stream *stream = context;
+	uint32_t handle = (uint32_t)(stream - audio_streams) + 1;
+	uint32_t grain = (uint32_t)(AUDIO_GRAIN * stream->bytes_per_frame);
+	uint8_t silence[AUDIO_GRAIN * 8 * 2];
+	uint8_t samples[AUDIO_GRAIN * 8 * 2];
+
+	memset(silence, 0, sizeof(silence));
+	while (!stream->closing)
+	{
+		const void *output = silence;
+
+		if (stream->running)
+		{
+			uint32_t buffered;
+
+			pthread_mutex_lock(&stream->lock);
+			buffered = stream->buffered;
+			pthread_mutex_unlock(&stream->lock);
+			/* the game's callback adds what is missing (SDL's
+			additional/total), with SDL_PutAudioStreamData */
+			if (buffered < grain && stream->callback)
+				host_call_guest(stream->callback, stream->userdata, handle, grain - buffered, grain);
+			pthread_mutex_lock(&stream->lock);
+			if (stream->buffered >= grain)
+			{
+				memcpy(samples, stream->buffer, grain);
+				memmove(stream->buffer, stream->buffer + grain, stream->buffered - grain);
+				stream->buffered -= grain;
+				output = samples;
+			}
+			pthread_mutex_unlock(&stream->lock);
+		}
+		/* (waits for the previous grain: the pace of the loop) */
+		sceAudioOutOutput(stream->port, output);
+	}
+	return NULL;
+}
+
+uint32_t host_sdl_open_audio_stream(uint32_t device, const void *spec, uint32_t callback, uint32_t userdata)
+{
+	const struct { int32_t format; int32_t channels; int32_t frequency; } *guest_spec = spec;
+	struct audio_stream *stream = NULL;
+	int index, format;
+	static int audio_initialized;
+
+	if (device == SDL_AUDIO_DEVICE_DEFAULT_RECORDING || !guest_spec)
+	{
+		set_error("no recording device on the PS4 yet");
+		return 0;
+	}
+	if ((guest_spec->format != SDL_AUDIO_S16LE && guest_spec->format != SDL_AUDIO_F32LE) ||
+		(guest_spec->channels != 1 && guest_spec->channels != 2) || guest_spec->frequency != 48000)
+	{
+		host_logf(HOST_LOG_ERROR, "audio: format %#x, %d channels at %d Hz is not supported",
+			(unsigned)guest_spec->format, guest_spec->channels, guest_spec->frequency);
+		set_error("unsupported audio format");
+		return 0;
+	}
+	for (index = 0; index < AUDIO_STREAMS && !stream; index++)
+	{
+		if (!audio_streams[index].used)
+			stream = &audio_streams[index];
+	}
+	if (!stream)
+		return 0;
+	if (!audio_initialized)
+	{
+		sceAudioOutInit();
+		audio_initialized = 1;
+	}
+	memset(stream, 0, sizeof(*stream));
+	pthread_mutex_init(&stream->lock, NULL);
+	stream->channels = guest_spec->channels;
+	stream->is_float = guest_spec->format == SDL_AUDIO_F32LE;
+	stream->bytes_per_frame = stream->channels * (stream->is_float ? 4 : 2);
+	stream->callback = callback;
+	stream->userdata = userdata;
+	format = stream->is_float ?
+		(stream->channels == 2 ? ORBIS_AUDIO_OUT_PARAM_FORMAT_FLOAT_STEREO : ORBIS_AUDIO_OUT_PARAM_FORMAT_FLOAT_MONO) :
+		(stream->channels == 2 ? ORBIS_AUDIO_OUT_PARAM_FORMAT_S16_STEREO : ORBIS_AUDIO_OUT_PARAM_FORMAT_S16_MONO);
+	/* (the system user: the main output) */
+	stream->port = sceAudioOutOpen(0xff, ORBIS_AUDIO_OUT_PORT_TYPE_MAIN, 0, AUDIO_GRAIN, 48000, format);
+	if (stream->port < 0)
+	{
+		host_logf(HOST_LOG_ERROR, "audio: sceAudioOutOpen %#x", (unsigned)stream->port);
+		set_error("sceAudioOutOpen failed");
+		return 0;
+	}
+	stream->used = 1;
+	if (host_native_thread_create(audio_main, stream, 256 * 1024, "audio") != 0)
+	{
+		sceAudioOutClose(stream->port);
+		stream->used = 0;
+		return 0;
+	}
+	host_logf(HOST_LOG_INFO, "audio: %d channels of %s at 48 kHz", stream->channels, stream->is_float ? "float" : "16-bit");
+	return (uint32_t)(stream - audio_streams) + 1;
+}
+
+int host_sdl_put_audio_stream_data(uint32_t handle, const void *data, int length)
+{
+	struct audio_stream *stream = audio_of(handle);
+	uint32_t room;
+
+	if (!stream || length < 0)
+		return 0;
+	pthread_mutex_lock(&stream->lock);
+	room = AUDIO_BUFFER - stream->buffered;
+	if ((uint32_t)length > room)
+		length = (int)room;
+	memcpy(stream->buffer + stream->buffered, data, (size_t)length);
+	stream->buffered += (uint32_t)length;
+	pthread_mutex_unlock(&stream->lock);
+	return 1;
+}
+
+int host_sdl_resume_audio_stream_device(uint32_t handle)
+{
+	struct audio_stream *stream = audio_of(handle);
+
+	if (!stream)
+		return 0;
+	stream->running = 1;
+	return 1;
+}
+
+int host_sdl_get_audio_stream_data(uint32_t handle, void *data, int length)
+{
+	(void)handle;
+	(void)data;
+	(void)length;
+	return 0;
+}
+
+int host_sdl_get_audio_stream_available(uint32_t handle)
+{
+	struct audio_stream *stream = audio_of(handle);
+
+	return stream ? (int)stream->buffered : 0;
+}
+
+void host_sdl_destroy_audio_stream(uint32_t handle)
+{
+	struct audio_stream *stream = audio_of(handle);
+
+	if (!stream)
+		return;
+	stream->running = 0;
+	stream->closing = 1;
+}
diff --git a/port/ps4/host/host_syscall.c b/port/ps4/host/host_syscall.c
new file mode 100644
index 00000000..f328939a
--- /dev/null
+++ b/port/ps4/host/host_syscall.c
@@ -0,0 +1,1232 @@
+/*
+HOST_SYSCALL.C
+
+System calls on behalf of the guest's musl runtime (its syscall_arch.h
+sends every call here), on the PS4.
+
+The guest's musl makes Linux system calls, numbered as AArch64's (the
+generic table, port/ps4/guest/libc/arch/x32_guest/bits/syscall.h.in), with
+Linux's flags, structures and error numbers. The PS4 has a FreeBSD kernel,
+which the host's C library speaks to: every call is translated here, through
+the host's own C library rather than the kernel. In particular:
+
+- open flags, error numbers and clocks are Linux's in the guest;
+- struct stat, struct dirent64 and timespec have the guest's layouts (its
+  time_t is 32-bit, as in the MSVC runtime);
+- the PS4 resolves no relative path (the SSBU port's finding): the guest's
+  working directory is kept here, and its relative paths made absolute;
+- futexes, which the PS4 lacks, are condition variables in buckets: a wake
+  wakes every waiter of the bucket, and musl's waits check again;
+- memory mappings stay below 4 GB (host_memory.c);
+- the standard output and error streams go to the host's log;
+- a read into a write-watched page would fail with EFAULT on the PS4 (it
+  does not fault): the pages are opened first (host_memory_prepare_write);
+- large writes (a checkpoint's 20 MB savegame.bin) are made by a thread of
+  their own, the data copied first, so the game does not wait for the
+  console's disk; anything else done with that file waits for them, and
+  fsync does nothing (the system writes its cache out itself);
+- the maps the package carries (/app0/maps) stand for the data folder's.
+*/
+
+#include "host.h"
+#include "guest_syscall_numbers.h"
+
+#include <dirent.h>
+#include <errno.h>
+#include <fcntl.h>
+#include <poll.h>
+#include <pthread.h>
+#include <sched.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/mman.h>
+#include <sys/stat.h>
+#include <sys/uio.h>
+#include <time.h>
+#include <unistd.h>
+
+int getentropy(void *buffer, size_t length);
+
+#define GUEST(type, value) ((type)(uintptr_t)(uint32_t)(value))
+
+/* ---------- Linux's numbers, as the guest has them */
+
+enum
+{
+	G_EPERM = 1, G_ENOENT = 2, G_ESRCH = 3, G_EINTR = 4, G_EIO = 5, G_ENXIO = 6, G_E2BIG = 7, G_EBADF = 9,
+	G_ECHILD = 10, G_EAGAIN = 11, G_ENOMEM = 12, G_EACCES = 13, G_EFAULT = 14, G_EBUSY = 16, G_EEXIST = 17,
+	G_EXDEV = 18, G_ENODEV = 19, G_ENOTDIR = 20, G_EISDIR = 21, G_EINVAL = 22, G_ENFILE = 23, G_EMFILE = 24,
+	G_ENOTTY = 25, G_EFBIG = 27, G_ENOSPC = 28, G_ESPIPE = 29, G_EROFS = 30, G_EMLINK = 31, G_EPIPE = 32,
+	G_ERANGE = 34, G_EDEADLK = 35, G_ENAMETOOLONG = 36, G_ENOLCK = 37, G_ENOSYS = 38, G_ENOTEMPTY = 39,
+	G_ELOOP = 40, G_EOVERFLOW = 75, G_ENOTSUP = 95, G_ETIMEDOUT = 110,
+};
+
+#define G_O_ACCMODE 03
+#define G_O_CREAT 0100
+#define G_O_EXCL 0200
+#define G_O_TRUNC 01000
+#define G_O_APPEND 02000
+#define G_O_NONBLOCK 04000
+#define G_O_DIRECTORY 040000
+#define G_O_CLOEXEC 02000000
+
+#define G_AT_FDCWD (-100)
+#define G_AT_REMOVEDIR 0x200
+#define G_AT_EMPTY_PATH 0x1000
+
+#define G_F_DUPFD 0
+#define G_F_GETFD 1
+#define G_F_SETFD 2
+#define G_F_GETFL 3
+#define G_F_SETFL 4
+#define G_F_GETLK 5
+#define G_F_SETLK 6
+#define G_F_SETLKW 7
+#define G_F_DUPFD_CLOEXEC 1030
+
+#define G_FUTEX_WAIT 0
+#define G_FUTEX_WAKE 1
+#define G_FUTEX_REQUEUE 3
+#define G_FUTEX_CMP_REQUEUE 4
+#define G_FUTEX_WAIT_BITSET 9
+#define G_FUTEX_WAKE_BITSET 10
+#define G_FUTEX_PRIVATE_FLAG 128
+#define G_FUTEX_CLOCK_REALTIME 256
+
+#define G_SIGABRT 6
+
+static long guest_error(int host_error)
+{
+	switch (host_error)
+	{
+	case EPERM: return -G_EPERM;
+	case ENOENT: return -G_ENOENT;
+	case ESRCH: return -G_ESRCH;
+	case EINTR: return -G_EINTR;
+	case EIO: return -G_EIO;
+	case ENXIO: return -G_ENXIO;
+	case E2BIG: return -G_E2BIG;
+	case EBADF: return -G_EBADF;
+	case ECHILD: return -G_ECHILD;
+	case EAGAIN: return -G_EAGAIN;
+	case ENOMEM: return -G_ENOMEM;
+	case EACCES: return -G_EACCES;
+	case EFAULT: return -G_EFAULT;
+	case EBUSY: return -G_EBUSY;
+	case EEXIST: return -G_EEXIST;
+	case EXDEV: return -G_EXDEV;
+	case ENODEV: return -G_ENODEV;
+	case ENOTDIR: return -G_ENOTDIR;
+	case EISDIR: return -G_EISDIR;
+	case EINVAL: return -G_EINVAL;
+	case ENFILE: return -G_ENFILE;
+	case EMFILE: return -G_EMFILE;
+	case ENOTTY: return -G_ENOTTY;
+	case EFBIG: return -G_EFBIG;
+	case ENOSPC: return -G_ENOSPC;
+	case ESPIPE: return -G_ESPIPE;
+	case EROFS: return -G_EROFS;
+	case EMLINK: return -G_EMLINK;
+	case EPIPE: return -G_EPIPE;
+	case ERANGE: return -G_ERANGE;
+	case EDEADLK: return -G_EDEADLK;
+	case ENAMETOOLONG: return -G_ENAMETOOLONG;
+	case ENOLCK: return -G_ENOLCK;
+	case ENOSYS: return -G_ENOSYS;
+	case ENOTEMPTY: return -G_ENOTEMPTY;
+	case ELOOP: return -G_ELOOP;
+	case EOVERFLOW: return -G_EOVERFLOW;
+	case ENOTSUP: return -G_ENOTSUP;
+	case ETIMEDOUT: return -G_ETIMEDOUT;
+	default: return -G_EIO;
+	}
+}
+
+static long result_of(long value)
+{
+	return value == -1 ? guest_error(errno) : value;
+}
+
+/* ---------- the guest's structures */
+
+struct guest_timespec
+{
+	int32_t seconds;
+	int32_t nanoseconds;
+};
+
+struct guest_iovec
+{
+	uint32_t base;
+	uint32_t length;
+};
+
+/* port/ps4/guest/libc/arch/x32_guest/kstat.h */
+struct guest_kstat
+{
+	uint64_t st_dev;
+	uint64_t st_ino;
+	uint32_t st_mode;
+	uint32_t st_nlink;
+	uint32_t st_uid;
+	uint32_t st_gid;
+	uint64_t st_rdev;
+	uint64_t pad;
+	int64_t st_size;
+	int32_t st_blksize;
+	int32_t pad2;
+	int64_t st_blocks;
+	int64_t st_atime_sec;
+	int64_t st_atime_nsec;
+	int64_t st_mtime_sec;
+	int64_t st_mtime_nsec;
+	int64_t st_ctime_sec;
+	int64_t st_ctime_nsec;
+	uint32_t unused[2];
+};
+
+struct guest_dirent64
+{
+	uint64_t d_ino;
+	int64_t d_off;
+	uint16_t d_reclen;
+	uint8_t d_type;
+	char d_name[];
+};
+
+/* musl's struct utsname */
+struct guest_utsname
+{
+	char sysname[65], nodename[65], release[65], version[65], machine[65], domainname[65];
+};
+
+/* musl's struct sysinfo, with the guest's 32-bit longs */
+struct guest_sysinfo
+{
+	int32_t uptime;
+	uint32_t loads[3];
+	uint32_t totalram, freeram, sharedram, bufferram, totalswap, freeswap;
+	uint16_t procs, pad;
+	uint32_t totalhigh, freehigh;
+	uint32_t mem_unit;
+	char reserved[256];
+};
+
+static int timespec_in(uint64_t address, struct timespec *result)
+{
+	const struct guest_timespec *value = GUEST(const struct guest_timespec *, address);
+
+	if (!address)
+		return 0;
+	result->tv_sec = value->seconds;
+	result->tv_nsec = value->nanoseconds;
+	return 1;
+}
+
+static void timespec_out(uint64_t address, const struct timespec *value)
+{
+	struct guest_timespec *result = GUEST(struct guest_timespec *, address);
+
+	if (!address)
+		return;
+	result->seconds = (int32_t)value->tv_sec;
+	result->nanoseconds = (int32_t)value->tv_nsec;
+}
+
+static void stat_out(const struct stat *information, uint64_t address)
+{
+	struct guest_kstat *result = GUEST(struct guest_kstat *, address);
+
+	memset(result, 0, sizeof(*result));
+	result->st_dev = (uint64_t)information->st_dev;
+	result->st_ino = (uint64_t)information->st_ino;
+	result->st_mode = (uint32_t)information->st_mode;
+	result->st_nlink = (uint32_t)information->st_nlink;
+	result->st_size = (int64_t)information->st_size;
+	result->st_blksize = (int32_t)information->st_blksize;
+	result->st_blocks = (int64_t)information->st_blocks;
+	result->st_atime_sec = (int64_t)information->st_atim.tv_sec;
+	result->st_atime_nsec = (int64_t)information->st_atim.tv_nsec;
+	result->st_mtime_sec = (int64_t)information->st_mtim.tv_sec;
+	result->st_mtime_nsec = (int64_t)information->st_mtim.tv_nsec;
+	result->st_ctime_sec = (int64_t)information->st_ctim.tv_sec;
+	result->st_ctime_nsec = (int64_t)information->st_ctim.tv_nsec;
+}
+
+/* ---------- paths: the guest's working directory */
+
+static char working_directory[1024] = HOST_DATA_ROOT;
+static pthread_mutex_t working_directory_lock = PTHREAD_MUTEX_INITIALIZER;
+
+/* The package's maps (/app0/maps, when it has them) in place of the data
+folder's maps folder; 0, or -errno */
+static long bundled_maps(char *path, size_t size)
+{
+	static const char data_maps[] = HOST_DATA_ROOT "/maps";
+	static int bundled = -1;
+	char rewritten[1024];
+
+	if (strncmp(path, data_maps, sizeof(data_maps) - 1) ||
+		(path[sizeof(data_maps) - 1] && path[sizeof(data_maps) - 1] != '/'))
+		return 0;
+	if (bundled < 0)
+	{
+		struct stat information;
+
+		bundled = stat(HOST_PACKAGE_ROOT "/maps/ui.map", &information) == 0;
+		host_logf(HOST_LOG_INFO, "maps: %s", bundled ? "the package's (" HOST_PACKAGE_ROOT "/maps)" :
+			"the data folder's (" HOST_DATA_ROOT "/maps)");
+	}
+	if (!bundled)
+		return 0;
+	if ((size_t)snprintf(rewritten, sizeof(rewritten), HOST_PACKAGE_ROOT "/maps%s",
+			path + sizeof(data_maps) - 1) >= size)
+		return -G_ENAMETOOLONG;
+	strcpy(path, rewritten);
+	return 0;
+}
+
+/* the host path of a guest path (relative to the working directory, or to
+the directory dirfd when it is not AT_FDCWD: not supported); 0, or -errno */
+static long host_path(int dirfd, uint64_t address, char *result, size_t size)
+{
+	const char *path = GUEST(const char *, address);
+	int written;
+
+	if (!address)
+		return -G_EFAULT;
+	if (path[0] == '/')
+	{
+		written = snprintf(result, size, "%s", path);
+	}
+	else
+	{
+		if (dirfd != G_AT_FDCWD)
+			return -G_ENOSYS;
+		pthread_mutex_lock(&working_directory_lock);
+		if (!strcmp(path, ".") || !path[0])
+			written = snprintf(result, size, "%s", working_directory);
+		else
+			written = snprintf(result, size, "%s/%s", working_directory, path[0] == '.' && path[1] == '/' ? path + 2 : path);
+		pthread_mutex_unlock(&working_directory_lock);
+	}
+	if (written < 0 || (size_t)written >= size)
+		return -G_ENAMETOOLONG;
+	return bundled_maps(result, size);
+}
+
+static int host_open_flags(int flags)
+{
+	int result = flags & G_O_ACCMODE;
+
+	if (flags & G_O_CREAT) result |= O_CREAT;
+	if (flags & G_O_EXCL) result |= O_EXCL;
+	if (flags & G_O_TRUNC) result |= O_TRUNC;
+	if (flags & G_O_APPEND) result |= O_APPEND;
+	if (flags & G_O_NONBLOCK) result |= O_NONBLOCK;
+	if (flags & G_O_DIRECTORY) result |= O_DIRECTORY;
+	return result;
+}
+
+static int guest_open_flags(int flags)
+{
+	int result = flags & O_ACCMODE;
+
+	if (flags & O_APPEND) result |= G_O_APPEND;
+	if (flags & O_NONBLOCK) result |= G_O_NONBLOCK;
+	return result;
+}
+
+static long guest_openat(int dirfd, uint64_t path, int flags, int mode)
+{
+	char resolved[1024];
+	long error = host_path(dirfd, path, resolved, sizeof(resolved));
+
+	if (error)
+		return error;
+	return result_of(open(resolved, host_open_flags(flags), mode));
+}
+
+static long guest_stat_at(int dirfd, uint64_t path, uint64_t result, int flags)
+{
+	char resolved[1024];
+	struct stat information;
+	long error;
+
+	if ((flags & G_AT_EMPTY_PATH) && path && !GUEST(const char *, path)[0])
+	{
+		if (fstat(dirfd, &information) != 0)
+			return guest_error(errno);
+		stat_out(&information, result);
+		return 0;
+	}
+	error = host_path(dirfd, path, resolved, sizeof(resolved));
+	if (error)
+		return error;
+	/* (the PS4 has no lstat or fstatat) */
+	if (stat(resolved, &information) != 0)
+		return guest_error(errno);
+	stat_out(&information, result);
+	return 0;
+}
+
+/* Linux's getdents64 from the PS4's getdents (FreeBSD's entries). A Linux
+entry is at most twice the size of the FreeBSD one it comes from (24 bytes
+for a 12-byte one), so reading half the guest's buffer always fits (musl's
+readdir reads into 2048 bytes; the kernel wants at least 512). */
+static long guest_getdents64(int fd, uint64_t buffer, uint32_t size)
+{
+	char entries[4096];
+	uint8_t *out = GUEST(uint8_t *, buffer);
+	uint32_t used = 0, wanted = (size / 2) & ~511u;
+	int got, offset = 0;
+
+	if (wanted < 512)
+		wanted = 512;
+	if (wanted > sizeof(entries))
+		wanted = sizeof(entries);
+	got = getdents(fd, (struct dirent *)entries, wanted);
+	if (got < 0)
+		return guest_error(errno);
+	while (offset < got)
+	{
+		const struct dirent *entry = (const struct dirent *)(entries + offset);
+		size_t name_length = strnlen(entry->d_name, entry->d_namlen);
+		uint32_t length = (uint32_t)((sizeof(struct guest_dirent64) + name_length + 1 + 7) & ~(size_t)7);
+		struct guest_dirent64 *result;
+
+		if (!entry->d_reclen || used + length > size)
+			break;
+		result = (struct guest_dirent64 *)(out + used);
+		/* (no inode: the PS4's headers spell its field two ways; musl's
+		readdir only wants it nonzero) */
+		result->d_ino = 1 + used;
+		result->d_off = used + length;
+		result->d_reclen = (uint16_t)length;
+		result->d_type = entry->d_type;
+		memcpy(result->d_name, entry->d_name, name_length);
+		result->d_name[name_length] = 0;
+		used += length;
+		offset += entry->d_reclen;
+	}
+	return used;
+}
+
+/* ---------- standard output and error */
+
+struct log_stream
+{
+	char line[1024];
+	size_t length;
+};
+
+static struct log_stream log_streams[2];
+static pthread_mutex_t log_lock = PTHREAD_MUTEX_INITIALIZER;
+
+static void log_bytes(int fd, const char *bytes, size_t size)
+{
+	struct log_stream *stream = &log_streams[fd == 2];
+	size_t index;
+
+	pthread_mutex_lock(&log_lock);
+	for (index = 0; index < size; index++)
+	{
+		char c = bytes[index];
+
+		if (c == '\n' || stream->length == sizeof(stream->line) - 1)
+		{
+			stream->line[stream->length] = 0;
+			host_log(fd == 2 ? HOST_LOG_WARN : HOST_LOG_INFO, stream->line);
+			stream->length = 0;
+			if (c == '\n')
+				continue;
+		}
+		stream->line[stream->length++] = c;
+	}
+	pthread_mutex_unlock(&log_lock);
+}
+
+static long guest_rw_vector(int fd, uint64_t vector, int count, int64_t offset, int positional, int writing)
+{
+	const struct guest_iovec *guest_vector = GUEST(const struct guest_iovec *, vector);
+	long total = 0;
+	int index;
+
+	if (count < 0 || count > 1024)
+		return -G_EINVAL;
+	for (index = 0; index < count; index++)
+	{
+		void *base = GUEST(void *, guest_vector[index].base);
+		size_t length = guest_vector[index].length;
+		ssize_t done;
+
+		if (!length)
+			continue;
+		if (writing && (fd == 1 || fd == 2))
+		{
+			log_bytes(fd, base, length);
+			done = (ssize_t)length;
+		}
+		else if (writing)
+		{
+			done = positional ? pwrite(fd, base, length, offset + total) : write(fd, base, length);
+		}
+		else
+		{
+			host_memory_prepare_write((uint64_t)(uintptr_t)base, length);
+			done = positional ? pread(fd, base, length, offset + total) : read(fd, base, length);
+		}
+		if (done < 0)
+			return total ? total : guest_error(errno);
+		total += done;
+		if ((size_t)done < length)
+			break;
+	}
+	return total;
+}
+
+/* ---------- futexes: condition variables in buckets */
+
+#define FUTEX_BUCKETS 64
+
+struct futex_bucket
+{
+	pthread_mutex_t lock;
+	pthread_cond_t condition;
+	int waiters;
+};
+
+static struct futex_bucket futex_buckets[FUTEX_BUCKETS];
+static pthread_once_t futex_once = PTHREAD_ONCE_INIT;
+
+static void futex_initialize(void)
+{
+	int index;
+
+	for (index = 0; index < FUTEX_BUCKETS; index++)
+	{
+		pthread_mutex_init(&futex_buckets[index].lock, NULL);
+		pthread_cond_init(&futex_buckets[index].condition, NULL);
+	}
+}
+
+static struct futex_bucket *futex_bucket(uint64_t address)
+{
+	pthread_once(&futex_once, futex_initialize);
+	return &futex_buckets[((address >> 2) * 2654435761u >> 7) % FUTEX_BUCKETS];
+}
+
+/* deadline: an absolute CLOCK_REALTIME time, or NULL */
+static long futex_wait(uint64_t address, uint32_t value, const struct timespec *deadline)
+{
+	struct futex_bucket *bucket = futex_bucket(address);
+	volatile uint32_t *word = GUEST(volatile uint32_t *, address);
+	long result = 0;
+
+	pthread_mutex_lock(&bucket->lock);
+	if (*word != value)
+	{
+		pthread_mutex_unlock(&bucket->lock);
+		return -G_EAGAIN;
+	}
+	bucket->waiters++;
+	if (deadline)
+	{
+		if (pthread_cond_timedwait(&bucket->condition, &bucket->lock, deadline) == ETIMEDOUT)
+			result = -G_ETIMEDOUT;
+	}
+	else
+	{
+		pthread_cond_wait(&bucket->condition, &bucket->lock);
+	}
+	bucket->waiters--;
+	pthread_mutex_unlock(&bucket->lock);
+	return result;
+}
+
+static long futex_wake(uint64_t address, uint32_t count)
+{
+	struct futex_bucket *bucket = futex_bucket(address);
+	int woken;
+
+	pthread_mutex_lock(&bucket->lock);
+	woken = bucket->waiters;
+	if (woken)
+		pthread_cond_broadcast(&bucket->condition);
+	pthread_mutex_unlock(&bucket->lock);
+	return woken < (int)count ? woken : (int)count;
+}
+
+static long guest_futex(uint64_t address, int operation, uint32_t value, uint64_t timeout, uint64_t address2,
+	uint32_t value3)
+{
+	int command = operation & ~(G_FUTEX_PRIVATE_FLAG | G_FUTEX_CLOCK_REALTIME);
+	struct timespec deadline;
+
+	(void)value3;
+	switch (command)
+	{
+	case G_FUTEX_WAIT:
+	case G_FUTEX_WAIT_BITSET:
+		if (timeout)
+		{
+			struct timespec given;
+
+			timespec_in(timeout, &given);
+			if (command == G_FUTEX_WAIT)
+			{
+				/* relative */
+				clock_gettime(CLOCK_REALTIME, &deadline);
+				deadline.tv_sec += given.tv_sec;
+				deadline.tv_nsec += given.tv_nsec;
+			}
+			else if (operation & G_FUTEX_CLOCK_REALTIME)
+			{
+				deadline = given;
+			}
+			else
+			{
+				/* absolute on the monotonic clock: as far from now in real time */
+				struct timespec now, real;
+
+				clock_gettime(CLOCK_MONOTONIC, &now);
+				clock_gettime(CLOCK_REALTIME, &real);
+				deadline.tv_sec = real.tv_sec + (given.tv_sec - now.tv_sec);
+				deadline.tv_nsec = real.tv_nsec + (given.tv_nsec - now.tv_nsec);
+			}
+			while (deadline.tv_nsec >= 1000000000L)
+			{
+				deadline.tv_sec++;
+				deadline.tv_nsec -= 1000000000L;
+			}
+			while (deadline.tv_nsec < 0)
+			{
+				deadline.tv_sec--;
+				deadline.tv_nsec += 1000000000L;
+			}
+		}
+		return futex_wait(address, value, timeout ? &deadline : NULL);
+	case G_FUTEX_WAKE:
+	case G_FUTEX_WAKE_BITSET:
+		return futex_wake(address, value);
+	case G_FUTEX_REQUEUE:
+	case G_FUTEX_CMP_REQUEUE:
+		/* everyone wakes (and checks again) */
+		if (command == G_FUTEX_CMP_REQUEUE && *GUEST(volatile uint32_t *, address) != value3)
+			return -G_EAGAIN;
+		futex_wake(address2, 0x7fffffff);
+		return futex_wake(address, 0x7fffffff);
+	default:
+		return -G_ENOSYS;
+	}
+}
+
+/* ---------- large writes on a thread of their own */
+
+#define WRITE_BEHIND_MINIMUM (128 * 1024)
+#define WRITE_BEHIND_LIMIT (96u << 20)
+#define WRITE_BEHIND_DESCRIPTORS 1024
+
+struct pending_write
+{
+	struct pending_write *next;
+	int fd;
+	off_t offset;
+	size_t size;
+	uint8_t data[];
+};
+
+static pthread_mutex_t write_lock = PTHREAD_MUTEX_INITIALIZER;
+static pthread_cond_t write_work = PTHREAD_COND_INITIALIZER;
+static pthread_cond_t write_done = PTHREAD_COND_INITIALIZER;
+static struct pending_write *write_head, *write_tail;
+static size_t write_bytes;
+static int write_pending[WRITE_BEHIND_DESCRIPTORS];
+static int write_thread_started;
+
+static void *write_main(void *unused)
+{
+	(void)unused;
+	for (;;)
+	{
+		struct pending_write *write;
+		size_t done = 0;
+
+		pthread_mutex_lock(&write_lock);
+		while (!write_head)
+			pthread_cond_wait(&write_work, &write_lock);
+		write = write_head;
+		write_head = write->next;
+		if (!write_head)
+			write_tail = NULL;
+		pthread_mutex_unlock(&write_lock);
+		while (done < write->size)
+		{
+			ssize_t written = pwrite(write->fd, write->data + done, write->size - done, write->offset + (off_t)done);
+
+			if (written <= 0)
+			{
+				host_logf(HOST_LOG_ERROR, "write of %zu bytes at %lld to file %d failed (%d)", write->size,
+					(long long)write->offset, write->fd, errno);
+				break;
+			}
+			done += (size_t)written;
+		}
+		pthread_mutex_lock(&write_lock);
+		write_bytes -= write->size;
+		write_pending[write->fd]--;
+		pthread_cond_broadcast(&write_done);
+		pthread_mutex_unlock(&write_lock);
+		free(write);
+	}
+	return NULL;
+}
+
+/* waits for the writes of fd still being made */
+static void write_wait(int fd)
+{
+	if (fd < 0 || fd >= WRITE_BEHIND_DESCRIPTORS || !__atomic_load_n(&write_pending[fd], __ATOMIC_ACQUIRE))
+		return;
+	pthread_mutex_lock(&write_lock);
+	while (write_pending[fd])
+		pthread_cond_wait(&write_done, &write_lock);
+	pthread_mutex_unlock(&write_lock);
+}
+
+void host_syscall_flush(void)
+{
+	pthread_mutex_lock(&write_lock);
+	while (write_head || write_bytes)
+		pthread_cond_wait(&write_done, &write_lock);
+	pthread_mutex_unlock(&write_lock);
+}
+
+/* takes a large write to a regular file (at offset, or at the file's position
+when offset < 0) for the writer thread; the size, or -1 when it is made here */
+static long write_behind(int fd, const void *data, size_t size, off_t offset)
+{
+	struct pending_write *write;
+	struct stat information;
+
+	if (size < WRITE_BEHIND_MINIMUM || fd < 3 || fd >= WRITE_BEHIND_DESCRIPTORS)
+		return -1;
+	if (fstat(fd, &information) != 0 || !S_ISREG(information.st_mode) || (fcntl(fd, F_GETFL) & O_APPEND))
+		return -1;
+	pthread_mutex_lock(&write_lock);
+	if (write_bytes + size > WRITE_BEHIND_LIMIT)
+	{
+		pthread_mutex_unlock(&write_lock);
+		return -1;
+	}
+	pthread_mutex_unlock(&write_lock);
+	write = malloc(sizeof(*write) + size);
+	if (!write)
+		return -1;
+	if (offset < 0)
+	{
+		offset = lseek(fd, 0, SEEK_CUR);
+		if (offset < 0 || lseek(fd, (off_t)size, SEEK_CUR) < 0)
+		{
+			free(write);
+			return -1;
+		}
+	}
+	memcpy(write->data, data, size);
+	write->next = NULL;
+	write->fd = fd;
+	write->offset = offset;
+	write->size = size;
+	pthread_mutex_lock(&write_lock);
+	if (!write_thread_started)
+	{
+		pthread_t thread;
+
+		write_thread_started = pthread_create(&thread, NULL, write_main, NULL) == 0;
+		if (!write_thread_started)
+		{
+			pthread_mutex_unlock(&write_lock);
+			lseek(fd, offset, SEEK_SET);
+			free(write);
+			return -1;
+		}
+	}
+	if (write_tail)
+		write_tail->next = write;
+	else
+		write_head = write;
+	write_tail = write;
+	write_bytes += size;
+	write_pending[fd]++;
+	pthread_cond_signal(&write_work);
+	pthread_mutex_unlock(&write_lock);
+	return (long)size;
+}
+
+/* ---------- clocks */
+
+static clockid_t host_clock(int64_t clock)
+{
+	switch (clock)
+	{
+	case 0: /* CLOCK_REALTIME */
+	case 5: /* CLOCK_REALTIME_COARSE */
+		return CLOCK_REALTIME;
+	default:
+		return CLOCK_MONOTONIC;
+	}
+}
+
+/* ---------- dispatch */
+
+static long long dispatch(long long number, long long a, long long b, long long c,
+	long long d, long long e, long long f)
+{
+	switch (number)
+	{
+	case GUEST_SYS_write:
+	{
+		long behind;
+
+		if (a == 1 || a == 2)
+		{
+			log_bytes((int)a, GUEST(const char *, b), (size_t)(uint32_t)c);
+			return (uint32_t)c;
+		}
+		write_wait((int)a);
+		behind = write_behind((int)a, GUEST(const void *, b), (size_t)(uint32_t)c, -1);
+		if (behind >= 0)
+			return behind;
+		return result_of(write((int)a, GUEST(const void *, b), (size_t)(uint32_t)c));
+	}
+	case GUEST_SYS_read:
+		host_memory_prepare_write((uint64_t)(uint32_t)b, (uint32_t)c);
+		return result_of(read((int)a, GUEST(void *, b), (size_t)(uint32_t)c));
+	case GUEST_SYS_pread64:
+		host_memory_prepare_write((uint64_t)(uint32_t)b, (uint32_t)c);
+		return result_of(pread((int)a, GUEST(void *, b), (size_t)(uint32_t)c, (off_t)d));
+	case GUEST_SYS_pwrite64:
+	{
+		long behind;
+
+		write_wait((int)a);
+		behind = write_behind((int)a, GUEST(const void *, b), (size_t)(uint32_t)c, (off_t)d);
+		if (behind >= 0)
+			return behind;
+		return result_of(pwrite((int)a, GUEST(const void *, b), (size_t)(uint32_t)c, (off_t)d));
+	}
+	case GUEST_SYS_writev:
+		return guest_rw_vector((int)a, (uint64_t)b, (int)c, 0, 0, 1);
+	case GUEST_SYS_pwritev:
+		return guest_rw_vector((int)a, (uint64_t)b, (int)c, d, 1, 1);
+	case GUEST_SYS_readv:
+		return guest_rw_vector((int)a, (uint64_t)b, (int)c, 0, 0, 0);
+	case GUEST_SYS_preadv:
+		return guest_rw_vector((int)a, (uint64_t)b, (int)c, d, 1, 0);
+
+	case GUEST_SYS_openat:
+		return guest_openat((int)a, (uint64_t)b, (int)c, (int)d);
+	case GUEST_SYS_close:
+		if (a >= 0 && a <= 2)
+			return 0;
+		return result_of(close((int)a));
+	case GUEST_SYS_lseek:
+		return result_of((long)lseek((int)a, (off_t)b, (int)c));
+	case GUEST_SYS_fstat:
+	{
+		struct stat information;
+
+		if (fstat((int)a, &information) != 0)
+			return guest_error(errno);
+		stat_out(&information, (uint64_t)b);
+		return 0;
+	}
+	case GUEST_SYS_newfstatat:
+		return guest_stat_at((int)a, (uint64_t)b, (uint64_t)c, (int)d);
+	case GUEST_SYS_getdents64:
+		return guest_getdents64((int)a, (uint64_t)b, (uint32_t)c);
+	case GUEST_SYS_mkdirat:
+	{
+		char resolved[1024];
+		long error = host_path((int)a, (uint64_t)b, resolved, sizeof(resolved));
+
+		return error ? error : result_of(mkdir(resolved, (mode_t)c));
+	}
+	case GUEST_SYS_unlinkat:
+	{
+		char resolved[1024];
+		long error = host_path((int)a, (uint64_t)b, resolved, sizeof(resolved));
+
+		if (error)
+			return error;
+		return result_of((c & G_AT_REMOVEDIR) ? rmdir(resolved) : unlink(resolved));
+	}
+	case GUEST_SYS_renameat:
+	case GUEST_SYS_renameat2:
+	{
+		char from[1024], to[1024];
+		long error = host_path((int)a, (uint64_t)b, from, sizeof(from));
+
+		if (!error)
+			error = host_path((int)c, (uint64_t)d, to, sizeof(to));
+		return error ? error : result_of(rename(from, to));
+	}
+	case GUEST_SYS_faccessat:
+	case GUEST_SYS_faccessat2:
+	{
+		char resolved[1024];
+		struct stat information;
+		long error = host_path((int)a, (uint64_t)b, resolved, sizeof(resolved));
+
+		/* (existence only: the game's files are all the app's) */
+		if (error)
+			return error;
+		return stat(resolved, &information) == 0 ? 0 : guest_error(errno);
+	}
+	case GUEST_SYS_readlinkat:
+		return -G_EINVAL;
+	case GUEST_SYS_ftruncate:
+		return result_of(ftruncate((int)a, (off_t)b));
+	case GUEST_SYS_fsync:
+	case GUEST_SYS_fdatasync:
+		/* (the console writes its cache out itself; a sync is a hitch) */
+		return 0;
+	case GUEST_SYS_fcntl:
+		switch ((int)b)
+		{
+		case G_F_GETFD:
+		case G_F_SETFD:
+		case G_F_GETLK:
+		case G_F_SETLK:
+		case G_F_SETLKW:
+			return 0;
+		case G_F_GETFL:
+		{
+			int flags = fcntl((int)a, F_GETFL);
+
+			return flags < 0 ? guest_error(errno) : guest_open_flags(flags);
+		}
+		case G_F_SETFL:
+			return result_of(fcntl((int)a, F_SETFL, host_open_flags((int)c) & (O_NONBLOCK | O_APPEND)));
+		case G_F_DUPFD:
+		case G_F_DUPFD_CLOEXEC:
+			return result_of(fcntl((int)a, F_DUPFD, (int)c));
+		default:
+			return -G_EINVAL;
+		}
+	case GUEST_SYS_dup:
+		return result_of(dup((int)a));
+	case GUEST_SYS_dup3:
+		return result_of(dup2((int)a, (int)b));
+	case GUEST_SYS_getcwd:
+	{
+		size_t length;
+
+		pthread_mutex_lock(&working_directory_lock);
+		length = strlen(working_directory) + 1;
+		if (length > (uint32_t)b)
+		{
+			pthread_mutex_unlock(&working_directory_lock);
+			return -G_ERANGE;
+		}
+		memcpy(GUEST(char *, a), working_directory, length);
+		pthread_mutex_unlock(&working_directory_lock);
+		return (long)length;
+	}
+	case GUEST_SYS_chdir:
+	{
+		char resolved[1024];
+		struct stat information;
+		long error = host_path(G_AT_FDCWD, (uint64_t)a, resolved, sizeof(resolved));
+
+		if (error)
+			return error;
+		if (stat(resolved, &information) != 0)
+			return guest_error(errno);
+		if (!S_ISDIR(information.st_mode))
+			return -G_ENOTDIR;
+		pthread_mutex_lock(&working_directory_lock);
+		snprintf(working_directory, sizeof(working_directory), "%s", resolved);
+		pthread_mutex_unlock(&working_directory_lock);
+		return 0;
+	}
+	case GUEST_SYS_utimensat:
+	case GUEST_SYS_fchmod:
+	case GUEST_SYS_fchmodat:
+	case GUEST_SYS_flock:
+	case GUEST_SYS_umask:
+		return 0;
+
+	case GUEST_SYS_clock_gettime:
+	{
+		struct timespec value;
+
+		if (clock_gettime(host_clock(a), &value) != 0)
+			return guest_error(errno);
+		timespec_out((uint64_t)b, &value);
+		return 0;
+	}
+	case GUEST_SYS_clock_getres:
+	{
+		struct timespec value = { 0, 1000 };
+
+		timespec_out((uint64_t)b, &value);
+		return 0;
+	}
+	case GUEST_SYS_gettimeofday:
+	{
+		struct timespec value;
+		struct guest_timespec *result = GUEST(struct guest_timespec *, a);
+
+		clock_gettime(CLOCK_REALTIME, &value);
+		if (result)
+		{
+			result->seconds = (int32_t)value.tv_sec;
+			result->nanoseconds = (int32_t)(value.tv_nsec / 1000);
+		}
+		return 0;
+	}
+	case GUEST_SYS_nanosleep:
+	case GUEST_SYS_clock_nanosleep:
+	{
+		struct timespec request;
+		uint64_t given = number == GUEST_SYS_nanosleep ? (uint64_t)a : (uint64_t)c;
+
+		if (!timespec_in(given, &request))
+			return -G_EFAULT;
+		if (number == GUEST_SYS_clock_nanosleep && (b & 1))
+		{
+			/* TIMER_ABSTIME: until then */
+			struct timespec now;
+
+			clock_gettime(host_clock(a), &now);
+			request.tv_sec -= now.tv_sec;
+			request.tv_nsec -= now.tv_nsec;
+			if (request.tv_nsec < 0)
+			{
+				request.tv_sec--;
+				request.tv_nsec += 1000000000L;
+			}
+			if (request.tv_sec < 0)
+				return 0;
+		}
+		nanosleep(&request, NULL);
+		return 0;
+	}
+	case GUEST_SYS_futex:
+		return guest_futex((uint64_t)a, (int)b, (uint32_t)c, (uint64_t)d, (uint64_t)e, (uint32_t)f);
+	case GUEST_SYS_ppoll:
+	{
+		struct timespec timeout;
+		int milliseconds = -1;
+
+		if (timespec_in((uint64_t)c, &timeout))
+			milliseconds = (int)(timeout.tv_sec * 1000 + timeout.tv_nsec / 1000000);
+		return result_of(poll(GUEST(struct pollfd *, a), (nfds_t)(uint32_t)b, milliseconds));
+	}
+	case GUEST_SYS_sched_yield:
+		return result_of(sched_yield());
+	case GUEST_SYS_getrandom:
+	{
+		uint8_t *buffer = GUEST(uint8_t *, a);
+		uint32_t size = (uint32_t)b, done = 0;
