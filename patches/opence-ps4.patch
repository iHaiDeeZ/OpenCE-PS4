diff --git a/port/ps4/guest/guest.ld b/port/ps4/guest/guest.ld
new file mode 100644
index 00000000..3d3e12ed
--- /dev/null
+++ b/port/ps4/guest/guest.ld
@@ -0,0 +1,30 @@
+/*
+GUEST.LD
+
+Layout of the PS4 guest image (tools/ps4_build.py): x32 code (x86-64
+instructions, 32-bit pointers) linked to run at HALO_GUEST_IMAGE_BASE
+(port/android/include/halo_android_abi.h), with the image header first. The
+host maps the loadable segments at these addresses (port/ps4/host/host_loader.c).
+*/
+
+ENTRY(__guest_header)
+
+SECTIONS
+{
+	. = 0x88000000;
+	.guest_header : { KEEP(*(.guest_header)) }
+	.text : { *(.text .text.*) }
+	.rodata : { *(.rodata .rodata.*) }
+	. = ALIGN(0x10000);
+	.data : { *(.data .data.*) *(.data.rel.ro .data.rel.ro.*) *(.got) *(.got.plt) }
+	.guest_init : {
+		__guest_init_start = .;
+		KEEP(*(SORT_BY_INIT_PRIORITY(.init_array.*)))
+		KEEP(*(.init_array))
+		__guest_init_end = .;
+	}
+	.bss : { *(.bss .bss.*) *(COMMON) }
+	. = ALIGN(0x4000);
+	__guest_image_end = .;
+	/DISCARD/ : { *(.comment) *(.note.*) *(.fini_array .fini_array.*) *(.eh_frame) *(.eh_frame_hdr) }
+}
diff --git a/port/ps4/guest/guest_sdl_ps4.c b/port/ps4/guest/guest_sdl_ps4.c
new file mode 100644
index 00000000..9292e6f6
--- /dev/null
+++ b/port/ps4/guest/guest_sdl_ps4.c
@@ -0,0 +1,571 @@
+/*
+GUEST_SDL_PS4.C
+
+The rest of the SDL3 functions the platform layer calls on the PS4. The
+Android guest's guest_sdl.c bridges those that Android's code paths use;
+the PS4 takes the desktop paths (the settings beside the game, the disc
+image's extraction, the display modes), whose SDL functions are answered here,
+in the guest, for a console with one fixed screen, no mouse, no keyboard,
+no file dialog and no SDL renderer (the extraction then shows no progress
+window).
+*/
+
+#include <dirent.h>
+#include <pthread.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <strings.h>
+#include <sys/stat.h>
+#include <time.h>
+#include <SDL3/SDL.h>
+
+#include "guest_host.h"
+
+/* ---------- atomics, mutexes, threads */
+
+int SDL_AddAtomicInt(SDL_AtomicInt *atomic, int value)
+{
+	return __atomic_fetch_add(&atomic->value, value, __ATOMIC_SEQ_CST);
+}
+
+int SDL_GetAtomicInt(SDL_AtomicInt *atomic)
+{
+	return __atomic_load_n(&atomic->value, __ATOMIC_SEQ_CST);
+}
+
+int SDL_SetAtomicInt(SDL_AtomicInt *atomic, int value)
+{
+	return __atomic_exchange_n(&atomic->value, value, __ATOMIC_SEQ_CST);
+}
+
+SDL_Mutex *SDL_CreateMutex(void)
+{
+	pthread_mutex_t *mutex = malloc(sizeof(*mutex));
+
+	if (mutex)
+		pthread_mutex_init(mutex, NULL);
+	return (SDL_Mutex *)mutex;
+}
+
+void SDL_LockMutex(SDL_Mutex *mutex)
+{
+	if (mutex)
+		pthread_mutex_lock((pthread_mutex_t *)mutex);
+}
+
+void SDL_UnlockMutex(SDL_Mutex *mutex)
+{
+	if (mutex)
+		pthread_mutex_unlock((pthread_mutex_t *)mutex);
+}
+
+void SDL_DestroyMutex(SDL_Mutex *mutex)
+{
+	if (mutex)
+	{
+		pthread_mutex_destroy((pthread_mutex_t *)mutex);
+		free(mutex);
+	}
+}
+
+Uint64 SDL_GetTicksNS(void)
+{
+	struct timespec now;
+
+	clock_gettime(CLOCK_MONOTONIC, &now);
+	return (Uint64)now.tv_sec * 1000000000ull + (Uint64)now.tv_nsec;
+}
+
+void SDL_DelayPrecise(Uint64 nanoseconds)
+{
+	struct timespec duration;
+
+	duration.tv_sec = (time_t)(nanoseconds / 1000000000ull);
+	duration.tv_nsec = (long)(nanoseconds % 1000000000ull);
+	nanosleep(&duration, NULL);
+}
+
+bool SDL_GetHintBoolean(const char *name, bool default_value)
+{
+	(void)name;
+	return default_value;
+}
+
+/* ---------- properties: none kept */
+
+SDL_PropertiesID SDL_CreateProperties(void)
+{
+	return 1;
+}
+
+void SDL_DestroyProperties(SDL_PropertiesID properties)
+{
+	(void)properties;
+}
+
+bool SDL_SetBooleanProperty(SDL_PropertiesID properties, const char *name, bool value)
+{
+	(void)properties;
+	(void)name;
+	(void)value;
+	return true;
+}
+
+bool SDL_SetNumberProperty(SDL_PropertiesID properties, const char *name, Sint64 value)
+{
+	(void)properties;
+	(void)name;
+	(void)value;
+	return true;
+}
+
+bool SDL_GetBooleanProperty(SDL_PropertiesID properties, const char *name, bool default_value)
+{
+	(void)properties;
+	(void)name;
+	return default_value;
+}
+
+float SDL_GetFloatProperty(SDL_PropertiesID properties, const char *name, float default_value)
+{
+	(void)properties;
+	(void)name;
+	return default_value;
+}
+
+/* ---------- the screen: one display, one mode, the window always on it */
+
+static SDL_DisplayMode screen_mode(void)
+{
+	SDL_DisplayMode mode;
+	int width = 1920, height = 1080;
+
+	host_sdl_window_size_in_pixels(1, &width, &height);
+	memset(&mode, 0, sizeof(mode));
+	mode.displayID = 1;
+	mode.format = SDL_PIXELFORMAT_ABGR8888;
+	mode.w = width;
+	mode.h = height;
+	mode.pixel_density = 1.0f;
+	mode.refresh_rate = 60.0f;
+	mode.refresh_rate_numerator = 60;
+	mode.refresh_rate_denominator = 1;
+	return mode;
+}
